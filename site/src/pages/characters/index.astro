---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import characters from '../../generated/characters.json';
import { withBase } from '../../lib/urls';
---
<BaseLayout title="人物｜《归途：奥德修斯》" description="奥德修斯、佩涅洛佩、忒勒马科斯、雅典娜与《归途》的主要人物。">
  <PageIntro eyebrow="CHARACTERS · IDENTITY & RECOGNITION" title="一个人，如何重新成为自己？" deck="名字、故事、伤疤、弓、婚床与土地，构成一条逐层收紧的辨认链。四位核心人物，各自在它面前承担不同的选择。" />
  <section class="principal-grid">
    {characters.core.map((character, index) => (
      <article>
        <a href={withBase(`characters/${character.slug}/`)}>
          <figure><ResponsiveImage src={character.image} responsive={character.image_responsive} alt={`${character.zh}批准角色设计页`} loading={index < 2 ? 'eager' : 'lazy'} /></figure>
          <div><p class="eyebrow">{character.en}</p><h2>{character.zh}</h2><p>{character.role}</p><span>人物档案 ↗</span></div>
        </a>
      </article>
    ))}
  </section>
  <section class="section supporting">
    <div class="section-header"><div><p class="eyebrow">SUPPORTING CAST</p><h2>众声之中</h2></div><p>支持人物按其在正式 V2 剧本中的场次数据恢复。每一个名字都承担关系、证词或后果，而不是一张脱离故事的演员表。</p></div>
    <ul>{characters.supporting.map((item) => <li><span>{item.name}</span><small>{item.episode_count} 集</small></li>)}</ul>
  </section>
</BaseLayout>
<style>.principal-grid{max-width:var(--content);margin:auto;display:grid;grid-template-columns:repeat(2,1fr);border-left:1px solid var(--rule)}.principal-grid article{border-right:1px solid var(--rule);border-bottom:1px solid var(--rule)}.principal-grid a{display:grid;grid-template-columns:1.05fr .95fr;text-decoration:none;height:100%}.principal-grid figure{margin:0;min-height:22rem;background:var(--black);overflow:hidden}.principal-grid img{display:block;width:100%;height:100%;object-fit:cover}.principal-grid article div{padding:clamp(1.5rem,4vw,3.5rem);display:flex;flex-direction:column;justify-content:center}.principal-grid h2{margin:.3rem 0}.principal-grid p:not(.eyebrow){color:var(--muted)}.principal-grid span{margin-top:auto;font-size:.75rem}.supporting ul{list-style:none;padding:2rem 0 0;display:grid;grid-template-columns:repeat(4,1fr)}.supporting li{display:flex;justify-content:space-between;border-top:1px solid var(--rule);padding:.75rem 1rem .75rem 0;font-family:var(--serif)}.supporting small{font-family:var(--sans);color:var(--muted)}@media(max-width:900px){.principal-grid{grid-template-columns:1fr}.supporting ul{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.principal-grid a{grid-template-columns:1fr}.principal-grid figure{min-height:110vw}.supporting ul{grid-template-columns:1fr}}</style>
