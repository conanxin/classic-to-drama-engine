---
import ResponsiveImage from './ResponsiveImage.astro';
import imageMetadata from '../generated/image-metadata.json';
import { withBase } from '../lib/urls';

interface Character { id:string; name:string; color:string; aliases:string[]; }
interface Props { panels:any[]; characters:Character[]; repairVariant?:string; composition?:string; }
const { panels, characters, repairVariant = '', composition = '' } = Astro.props;
const ep01Repair = repairVariant === 'ep01-r1' || repairVariant === 'ep01-r2';
const ep01Final = repairVariant === 'ep01-r2';
const speakerColor = (speaker:string) => characters.find((character) => speaker.includes(character.name))?.color || 'var(--graphic-accent)';
const previewStyle = (src:string) => {
  const preview = (imageMetadata as Record<string, { responsive_w720:string }>)[src]?.responsive_w720 || src;
  return `--panel-preview:url("${withBase(preview)}")`;
};
const sourceLabel:Record<string,string> = {
  P4_HIGH_FIDELITY:'P4 approved high-fidelity',
  STORYBOARD_DERIVED_PANEL:'P4 single-frame storyboard derivative',
  ANIMATIC_DERIVED_PANEL:'P5 animatic-card derivative',
  P8_EXISTING_HIGH_FIDELITY_FINAL:'P8 accepted existing high-fidelity art',
  P8_FINAL_COMIC_ART:'P8 final comic art'
};
const wideTypes = new Set(['ESTABLISHING','ACTION','REVEAL','ENVIRONMENT','CLIMAX','POV']);
---
<ol class:list={['panel-sequence', { 'ep01-repair':ep01Repair, 'ep01-final':ep01Final }, composition && `composition-${composition}`]} aria-label="本场图像小说式叙事序列">
  {panels.map((panel, index) => (
    <li class:list={['panel-card', `panel-${panel.panel_type.toLowerCase()}`, `ratio-${panel.ratio.replace(':','-')}`, panel.presentation?.width && `width-${panel.presentation.width}`, panel.presentation?.dialogue_align && `dialogue-${panel.presentation.dialogue_align}`, panel.presentation?.text_role && `role-${panel.presentation.text_role.toLowerCase()}`, panel.presentation?.crop && `crop-${panel.presentation.crop}`, { wide:wideTypes.has(panel.panel_type), silent:panel.silent }]} data-panel-id={panel.panel_id} data-text-role={panel.presentation?.text_role}>
      <figure style={ep01Final ? previewStyle(panel.visual.public_path) : undefined} data-preview-art={ep01Final ? 'real' : undefined}>
        <ResponsiveImage src={panel.visual.public_path} alt={panel.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} sizes="(max-width: 850px) calc(100vw - 2rem), 70vw" />
        {panel.caption && <figcaption><span>叙述</span>{panel.caption}</figcaption>}
      </figure>
      {panel.dialogue && <blockquote class="panel-bubble" style={`--speaker:${speakerColor(panel.dialogue.speaker)}`}>
        <cite>{panel.dialogue.speaker}</cite><p>{panel.dialogue.text}</p>
      </blockquote>}
      {panel.silent && <span class="silent-beat" aria-label="无对白画面">无对白</span>}
      <details class="panel-provenance" data-pagefind-ignore>
        <summary>画面依据</summary>
        <p><strong>{sourceLabel[panel.visual.source_kind]}</strong><span>{panel.shot_id} · {panel.panel_type}</span><span>{panel.visual.authority}</span></p>
      </details>
    </li>
  ))}
</ol>
<style>
  .panel-sequence{list-style:none;padding:0;margin:1.5rem 0 0;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:clamp(.75rem,1.8vw,1.4rem);align-items:start}.panel-card{grid-column:span 6;position:relative;min-width:0;background:var(--graphic-black);border:1px solid var(--graphic-rule);overflow:clip}.panel-card.wide{grid-column:1/-1}.panel-card:nth-child(3n+2):not(.wide){grid-column:span 7}.panel-card:nth-child(3n):not(.wide){grid-column:span 5}
  figure{margin:0;position:relative;background:#090908;overflow:hidden}.ratio-16-9 figure{aspect-ratio:16/9}.ratio-3-2 figure{aspect-ratio:3/2}.ratio-4-3 figure{aspect-ratio:4/3}.ratio-1-1 figure{aspect-ratio:1/1}figcaption{position:absolute;left:0;bottom:0;max-width:min(32rem,90%);padding:.7rem .85rem;background:rgba(12,12,11,.88);color:var(--graphic-paper);font-family:var(--serif);font-size:clamp(.74rem,1.2vw,.9rem);line-height:1.55;border-top:2px solid var(--graphic-accent)}figcaption span{display:block;margin-bottom:.18rem;color:var(--graphic-accent);font-family:var(--sans);font-size:.48rem;letter-spacing:.12em}
  .panel-bubble{position:relative;margin:-1.1rem clamp(.7rem,3vw,1.4rem) 1rem auto;width:min(82%,28rem);padding:.8rem 1rem .7rem;background:var(--graphic-paper);color:var(--graphic-ink);border-left:4px solid var(--speaker);box-shadow:0 .7rem 1.7rem rgba(0,0,0,.3);z-index:2}.panel-bubble::before{content:"";position:absolute;top:-.55rem;right:1.4rem;border-width:0 .55rem .6rem;border-style:solid;border-color:transparent transparent var(--graphic-paper)}.panel-bubble p{font-family:var(--serif);font-size:clamp(.92rem,1.45vw,1.1rem);line-height:1.65;margin:0 0 .35rem}.panel-bubble cite{font-style:normal;color:var(--speaker);font-size:.56rem;letter-spacing:.1em}.silent-beat{position:absolute;left:.65rem;top:.65rem;padding:.22rem .4rem;background:rgba(12,12,11,.7);color:var(--graphic-muted);font-size:.48rem;letter-spacing:.12em}
  .panel-provenance{border-top:1px solid var(--graphic-rule);color:var(--graphic-muted)}.panel-provenance summary{cursor:pointer;list-style:none;padding:.48rem .65rem;font-size:.5rem;letter-spacing:.1em}.panel-provenance summary::-webkit-details-marker{display:none}.panel-provenance p{display:flex;flex-wrap:wrap;gap:.35rem 1rem;margin:0;padding:0 .65rem .65rem;font-size:.52rem}.panel-provenance strong{color:var(--graphic-paper);font-weight:500}.panel-provenance span:last-child{width:100%}
  .ep01-repair{gap:clamp(.65rem,1.45vw,1.15rem);margin-top:1rem}.ep01-repair .panel-card{background:transparent;border:0;overflow:visible}.ep01-repair .panel-card figure{border:1px solid color-mix(in srgb,var(--graphic-rule) 70%,transparent);box-shadow:0 .8rem 2.3rem rgba(0,0,0,.17)}.ep01-repair .panel-card.width-wide{grid-column:1/-1}.ep01-repair figcaption{max-width:min(34rem,72%);padding:.65rem .85rem;background:linear-gradient(90deg,rgba(13,13,12,.94),rgba(13,13,12,.76));border-top:0;border-left:3px solid var(--graphic-accent);font-size:clamp(.82rem,1.25vw,1rem)}
  .ep01-repair .panel-bubble{width:min(76%,25rem);margin:.65rem 0 0;padding:.72rem .9rem .75rem;background:#eee5d2;border:0;border-top:3px solid var(--speaker);box-shadow:0 .55rem 1.4rem rgba(0,0,0,.2)}.ep01-repair .panel-bubble::before{display:none}.ep01-repair .panel-bubble cite{display:block;margin-bottom:.28rem;color:var(--speaker);font-family:var(--sans);font-size:.56rem;font-weight:700;letter-spacing:.08em}.ep01-repair .panel-bubble p{font-size:clamp(1rem,1.6vw,1.25rem);line-height:1.55;margin:0}.ep01-repair .dialogue-left-under .panel-bubble{margin-right:auto}.ep01-repair .dialogue-right-under .panel-bubble{margin-left:auto}.ep01-repair .dialogue-left-overlay .panel-bubble,.ep01-repair .dialogue-right-overlay .panel-bubble{position:absolute;bottom:clamp(.75rem,2vw,1.4rem);z-index:2;margin:0}.ep01-repair .dialogue-left-overlay .panel-bubble{left:clamp(.7rem,2vw,1.25rem)}.ep01-repair .dialogue-right-overlay .panel-bubble{right:clamp(.7rem,2vw,1.25rem)}.ep01-repair .panel-provenance{margin-top:.38rem;border:0}.ep01-repair .panel-provenance summary{display:inline-flex;padding:.28rem 0;color:color-mix(in srgb,var(--graphic-muted) 75%,transparent)}.ep01-repair .silent-beat{background:rgba(12,12,11,.54)}
  .ep01-final .panel-card figure{background-color:#29261f;background-image:linear-gradient(rgba(18,17,14,.08),rgba(18,17,14,.08)),var(--panel-preview);background-size:cover;background-position:center}.ep01-final figcaption{max-width:min(31rem,68%);padding:.52rem .7rem .58rem;background:#b9aa91;color:#191713;border:0;border-left:3px solid #713329;box-shadow:0 .35rem 1rem rgba(0,0,0,.24);font-size:clamp(.78rem,1.1vw,.92rem);line-height:1.5}.ep01-final figcaption span{color:#713329}.ep01-final .panel-bubble{background:#f0e6d2;box-shadow:0 .42rem 1.25rem rgba(0,0,0,.24)}.ep01-final .panel-bubble::after{content:"";position:absolute;width:0;height:0;border:.58rem solid transparent}.ep01-final .dialogue-left-under .panel-bubble::after{top:-1.08rem;left:1.2rem;border-bottom-color:#f0e6d2}.ep01-final .dialogue-right-under .panel-bubble::after{top:-1.08rem;right:1.2rem;border-bottom-color:#f0e6d2}.ep01-final .dialogue-left-overlay .panel-bubble::after{left:-1.05rem;bottom:.85rem;border-right-color:#f0e6d2}.ep01-final .dialogue-right-overlay .panel-bubble::after{right:-1.05rem;bottom:.85rem;border-left-color:#f0e6d2}.ep01-final .crop-reaction-right figure{aspect-ratio:4/3}.ep01-final .crop-reaction-right figure :global(img){object-fit:cover;object-position:84% 52%;transform:scale(1.72);transform-origin:89% 55%}
  .composition-establish-reaction-pair .panel-card:nth-child(2),.composition-crowd-action-mosaic .panel-card:nth-child(2){grid-column:span 5}.composition-establish-reaction-pair .panel-card:nth-child(3),.composition-crowd-action-mosaic .panel-card:nth-child(3){grid-column:span 7}.composition-threshold-dialogue-sequence .panel-card:nth-child(2){grid-column:span 7}.composition-threshold-dialogue-sequence .panel-card:nth-child(3){grid-column:span 5}.composition-intimate-prop-triptych .panel-card:nth-child(1){grid-column:span 7}.composition-intimate-prop-triptych .panel-card:nth-child(2){grid-column:span 5}.composition-intimate-cliffhanger .panel-card:nth-child(1){grid-column:1/-1}.composition-intimate-cliffhanger .panel-card:nth-child(2){grid-column:span 5}.composition-intimate-cliffhanger .panel-card:nth-child(3){grid-column:span 7}
  @media(max-width:700px){.panel-sequence{display:block;margin-top:1rem}.panel-card,.panel-card.wide,.panel-card:nth-child(3n+2):not(.wide),.panel-card:nth-child(3n):not(.wide){margin-bottom:.85rem}.panel-card figure{aspect-ratio:auto;min-height:10rem}.panel-card figure :global(img){min-height:10rem;max-height:70vh;object-fit:cover}.panel-bubble{width:calc(100% - 1.4rem);margin:-.65rem .7rem .8rem}.panel-provenance summary{min-height:2rem;display:flex;align-items:center}.ep01-repair .panel-card{margin-bottom:1.15rem}.ep01-repair .panel-card figure{min-height:0}.ep01-repair .panel-card figure :global(img){width:100%;height:auto;min-height:0;max-height:none;object-fit:contain}.ep01-repair figcaption{position:static;max-width:none;border-left:0;border-top:2px solid var(--graphic-accent);background:#1a1916;font-size:.92rem}.ep01-repair .dialogue-left-overlay .panel-bubble,.ep01-repair .dialogue-right-overlay .panel-bubble{position:relative;inset:auto;width:calc(100% - 1rem);margin:-.2rem .5rem 0}.ep01-repair .panel-bubble{width:calc(100% - 1rem);margin:.45rem .5rem 0}.ep01-repair .panel-bubble p{font-size:1.06rem;line-height:1.6}.ep01-repair .panel-provenance{margin-inline:.5rem}.ep01-final figcaption{max-width:none;background:#b9aa91;color:#191713;border-top:0;border-left:3px solid #713329}.ep01-final .crop-reaction-right figure{aspect-ratio:4/3}.ep01-final .crop-reaction-right figure :global(img){height:100%;object-fit:cover;object-position:84% 52%;transform:scale(1.72);transform-origin:89% 55%}.ep01-final .dialogue-left-overlay .panel-bubble::after,.ep01-final .dialogue-right-overlay .panel-bubble::after{top:-1.08rem;bottom:auto;left:1.2rem;right:auto;border-color:transparent transparent #f0e6d2 transparent}}
</style>
<style is:global>.panel-card figure picture,.panel-card figure img{display:block;width:100%;height:100%}.panel-card figure img{object-fit:cover}</style>
