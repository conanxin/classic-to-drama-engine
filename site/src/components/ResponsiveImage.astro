---
import { withBase } from '../lib/urls';
import imageMetadata from '../generated/image-metadata.json';
interface Props { src:string; responsive?:string|null; alt:string; loading?:'eager'|'lazy'; fetchpriority?:'high'|'low'|'auto'; sizes?:string; }
const { src, responsive, alt, loading='lazy', fetchpriority='auto', sizes='(max-width: 800px) 100vw, 1600px' } = Astro.props;
const metadata = (imageMetadata as Record<string, { width:number; height:number; responsive_w720:string; responsive_w1600:string }>)[src];
const mobile = responsive || metadata?.responsive_w720;
const srcset = metadata ? `${withBase(mobile)} 720w, ${withBase(metadata.responsive_w1600)} 1600w` : null;
---
<picture>
  {srcset ? <source srcset={srcset} sizes={sizes} type="image/webp" /> : mobile && <source srcset={withBase(mobile)} type="image/webp" />}
  <img src={withBase(src)} alt={alt} loading={loading} fetchpriority={fetchpriority} width={metadata?.width} height={metadata?.height} decoding="async" />
</picture>
<style>picture{display:contents}</style>
