---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import graphicEpisodes from '../../generated/graphic-episodes.json';
import characterRegistry from '../../generated/graphic-characters-p7b.json';
import { episodePath, formatRuntime, graphicEpisodePath, withBase } from '../../lib/urls';
const characterMap = new Map(characterRegistry.characters.map((item) => [item.id, item]));
const movements = [...new Map(graphicEpisodes.map((episode) => [episode.story_arc_id, { id:episode.story_arc_id, title:episode.story_stage.split('｜')[0] }])).values()];
const pad = (number:number) => String(number).padStart(2, '0');
---
<BaseLayout title="30 集 Graphic Novel Script｜《归途：奥德修斯》" description="《归途：奥德修斯》完整 30 集、150 场图像小说式短剧剧本。保留完整 Script Mode，并以图像、对白、人物与空间辅助连续阅读。" image={withBase(graphicEpisodes[18].cover_visual.path)}>
  <div class="graphic-index">
    <header class="graphic-hero">
      <div class="hero-copy">
        <p class="eyebrow">GRAPHIC NOVEL SCRIPT · 30 EPISODES</p>
        <h1>从失去名字，<br />到被家认出。</h1>
        <p>30 集、150 场完整图像小说式短剧剧本。每场以真实批准画面、精选原文对白与完整 V2 source layer 组成；你可以一路读到底，也可以随时切回专业剧本。</p>
        <nav><a href={graphicEpisodePath(1)}>从 EP01 开始</a><a href={episodePath(1)}>切到 Script Mode</a></nav>
      </div>
      <figure class="hero-visual"><ResponsiveImage src={graphicEpisodes[18].cover_visual.path} alt={graphicEpisodes[18].cover_visual.alt} loading="eager" fetchpriority="high" sizes="(max-width: 850px) 100vw, 60vw" /></figure>
    </header>

    <aside class="continue-reading" data-continue-reading data-episode-base={withBase('episodes/')} hidden data-pagefind-ignore>
      <div><p class="eyebrow">CONTINUE READING</p><h2>继续上次的场次</h2><p data-continue-summary></p></div>
      <nav><a data-continue-link href={graphicEpisodePath(1)}>继续阅读</a><button type="button" data-clear-resume>清除本机记录</button></nav>
    </aside>

    <section class="series-map" aria-labelledby="series-map-title">
      <header><p class="eyebrow">VISUAL STORY MAP</p><h2 id="series-map-title">五段归途，三十个入口</h2><p>Arc 划分直接来自冻结的 30 集 architecture。地点提示帮助复位，不把它扩张成知识图谱。</p></header>
      <ol>{graphicEpisodes.map((episode) => <li style={`--episode:${episode.palette.accent}`}><a href={graphicEpisodePath(episode.number)}><span>{pad(episode.number)}</span><strong>{episode.title}</strong><small>{episode.geography.slice(0,2).join(' / ')}</small></a></li>)}</ol>
    </section>

    <main class="episode-directory">
      {movements.map((movement, movementIndex) => {
        const episodes = graphicEpisodes.filter((episode) => episode.story_arc_id === movement.id);
        return <section class="movement" aria-labelledby={`movement-${movementIndex + 1}`}>
          <header><p>ARC {pad(movementIndex + 1)}</p><h2 id={`movement-${movementIndex + 1}`}>{movement.title}</h2><span>EP{pad(episodes[0]!.number)}–EP{pad(episodes.at(-1)!.number)}</span></header>
          <ol>{episodes.map((episode) => <li>
            <a class="episode-row" href={graphicEpisodePath(episode.number)}>
              <span class="episode-number">EP <b>{pad(episode.number)}</b></span>
              <figure><ResponsiveImage src={episode.cover_visual.path} alt={episode.cover_visual.alt} loading="lazy" sizes="(max-width: 700px) 38vw, 15vw" /></figure>
              <div><p>{episode.story_stage}</p><h3>{episode.title}</h3><small>{episode.core_conflict}</small></div>
              <dl><div><dt>时长</dt><dd>{formatRuntime(episode.runtime_seconds)}</dd></div><div><dt>场次</dt><dd>{episode.scenes.length}</dd></div><div><dt>人物</dt><dd>{episode.cast.slice(0,3).map((id) => characterMap.get(id)?.name).filter(Boolean).join('、')}</dd></div></dl>
              <i aria-hidden="true">→</i>
            </a>
          </li>)}</ol>
        </section>;
      })}
    </main>

    <section class="system-note"><p class="eyebrow">ONE STORY · TWO READING LAYERS</p><h2>图像安排复杂信息，<br />原文保留判断权。</h2><div><p><strong>人物识别</strong>稳定 identity、状态、阵营与称谓；细节只在需要时展开。</p><p><strong>漫画化序列</strong>每场 3–6 个有顺序的 visual beat，不是剧本配一张图。</p><p><strong>空间与关键物</strong>门、弓、斧、伤疤、床与武器 custody 沿 source continuity 回收。</p><p><strong>完整原文</strong>每场展开层与 Script Mode 都回到同一份 V2 Markdown。</p></div></section>
  </div>
</BaseLayout>
<script>
  const resume = document.querySelector<HTMLElement>('[data-continue-reading]');
  if (resume) {
    try {
      const state = JSON.parse(localStorage.getItem('ctde-graphic-resume-v1') || 'null');
      if (Number(state?.episode) >= 1 && Number(state?.episode) <= 30) {
        const episode = String(state.episode).padStart(2, '0');
        const scene = Math.max(1, Math.min(5, Number(state.scene || 1)));
        const base = resume.dataset.episodeBase || '';
        const link = resume.querySelector<HTMLAnchorElement>('[data-continue-link]');
        const summary = resume.querySelector<HTMLElement>('[data-continue-summary]');
        if (link) link.href = `${base}${episode}/graphic/?resume=1#scene-${scene}`;
        if (summary) summary.textContent = `EP${episode} · 场 ${String(scene).padStart(2,'0')} · Graphic Mode`;
        resume.hidden = false;
      }
    } catch { /* optional local state */ }
    resume.querySelector<HTMLButtonElement>('[data-clear-resume]')?.addEventListener('click', () => { localStorage.removeItem('ctde-graphic-resume-v1'); resume.hidden = true; });
  }
</script>
<style>
  .graphic-index{--g-paper:#d8cfbb;--g-paper-2:#c6bda9;--g-ink:#151513;--g-muted:#9e9687;--g-rule:rgba(216,207,187,.22);background:var(--g-ink);color:var(--g-paper)}.graphic-hero{display:grid;grid-template-columns:minmax(22rem,.8fr) minmax(0,1.2fr);min-height:calc(100vh - var(--header));border-bottom:1px solid var(--g-rule)}.hero-copy{padding:clamp(4rem,8vw,8rem) var(--pad);display:flex;flex-direction:column;justify-content:center}.hero-copy h1{font-size:clamp(3.7rem,8vw,7.5rem);margin:.6rem 0 1.6rem;line-height:.9}.hero-copy>p:not(.eyebrow){max-width:35rem;font-family:var(--serif);font-size:clamp(1.05rem,1.8vw,1.35rem);color:var(--g-paper-2)}.hero-copy nav{display:flex;gap:.7rem;margin-top:2rem}.hero-copy nav a{padding:.75rem 1rem;border:1px solid var(--g-rule);text-decoration:none;font-size:.7rem}.hero-copy nav a:first-child{background:var(--g-paper);color:var(--g-ink)}.hero-visual{margin:0;min-width:0;min-height:100%;background:#0c0c0b;overflow:hidden}
  .continue-reading{max-width:92rem;margin:0 auto;padding:1.2rem var(--pad);border-bottom:1px solid var(--g-rule);display:flex;justify-content:space-between;gap:2rem;align-items:center}.continue-reading[hidden]{display:none}.continue-reading h2{font-size:1.25rem;margin:.25rem 0}.continue-reading p:last-child{margin:0;color:var(--g-muted);font-size:.72rem}.continue-reading nav{display:flex;align-items:center;gap:.6rem}.continue-reading a,.continue-reading button{padding:.65rem .8rem;border:1px solid var(--g-rule);background:transparent;color:var(--g-paper);font:inherit;font-size:.65rem}.continue-reading a{background:var(--g-paper);color:var(--g-ink);text-decoration:none}.continue-reading button{cursor:pointer}
  .series-map{max-width:92rem;margin:auto;padding:clamp(4rem,7vw,7rem) var(--pad);border-bottom:1px solid var(--g-rule)}.series-map>header{display:grid;grid-template-columns:12rem 1fr minmax(18rem,.6fr);gap:2rem;align-items:end}.series-map h2{margin:0}.series-map>header>p:last-child{font-family:var(--serif);color:var(--g-muted);margin:0}.series-map ol{list-style:none;margin:3rem 0 0;padding:0;display:grid;grid-template-columns:repeat(10,1fr);border-top:1px solid var(--g-rule);border-left:1px solid var(--g-rule)}.series-map li{min-width:0}.series-map a{display:flex;min-height:7.5rem;padding:.6rem;flex-direction:column;border-right:1px solid var(--g-rule);border-bottom:1px solid var(--g-rule);text-decoration:none;background:linear-gradient(to bottom,color-mix(in srgb,var(--episode) 18%,transparent),transparent 55%)}.series-map span{color:var(--episode);font-size:.58rem}.series-map strong{font-family:var(--serif);font-size:.7rem;font-weight:500;margin:.45rem 0 auto}.series-map small{font-size:.46rem;color:var(--g-muted)}
  .episode-directory{max-width:92rem;margin:auto;padding:clamp(4rem,7vw,7rem) var(--pad)}.movement{margin-bottom:6rem}.movement>header{display:grid;grid-template-columns:7rem minmax(0,1fr) auto;gap:1rem;align-items:baseline;border-bottom:2px solid var(--g-paper);padding-bottom:1rem}.movement>header p,.movement>header span{font-size:.58rem;color:var(--g-muted);letter-spacing:.12em}.movement h2{font-size:clamp(2rem,4vw,4rem);margin:0}.movement>ol{list-style:none;margin:0;padding:0}.movement>ol>li{border-bottom:1px solid var(--g-rule)}.episode-row{display:grid;grid-template-columns:5rem 12rem minmax(0,1fr) 19rem auto;gap:clamp(.8rem,2vw,2rem);align-items:center;padding:1.2rem 0;text-decoration:none}.episode-number{font-size:.56rem;color:var(--g-muted)}.episode-number b{display:block;font-family:var(--serif);font-size:2rem;color:var(--g-paper);font-weight:400}.episode-row figure{margin:0;aspect-ratio:16/9;overflow:hidden;background:#090908}.episode-row h3{font-size:clamp(1.3rem,2.2vw,2rem);margin:.15rem 0}.episode-row div>p{margin:0;color:var(--rust);font-size:.53rem}.episode-row div>small{font-family:var(--serif);color:var(--g-muted);font-size:.75rem}.episode-row dl{display:grid;grid-template-columns:4rem 4rem 1fr;gap:.6rem;margin:0}.episode-row dt{font-size:.48rem;color:var(--g-muted)}.episode-row dd{margin:.2rem 0 0;font-size:.58rem}.episode-row>i{font-style:normal;color:var(--rust)}
  .system-note{max-width:92rem;margin:auto;padding:clamp(4rem,8vw,8rem) var(--pad);border-top:1px solid var(--g-rule)}.system-note h2{max-width:20ch}.system-note>div{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-top:4rem}.system-note>div p{border-top:2px solid var(--rust);padding-top:1rem;color:var(--g-muted);font-family:var(--serif)}.system-note strong{display:block;color:var(--g-paper);font-family:var(--sans);font-size:.75rem;margin-bottom:.5rem}
  @media(max-width:1000px){.series-map ol{grid-template-columns:repeat(6,1fr)}.episode-row{grid-template-columns:4rem 10rem 1fr auto}.episode-row dl{display:none}}
  @media(max-width:850px){.graphic-hero{grid-template-columns:1fr;min-height:0}.hero-copy{min-height:32rem}.hero-visual{height:min(70vh,38rem)}.series-map>header{display:block}.series-map h2{margin:.5rem 0 1rem}.series-map ol{grid-template-columns:repeat(5,1fr)}.system-note>div{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.hero-copy{min-height:29rem}.hero-copy h1{font-size:3.7rem}.hero-copy nav,.continue-reading,.continue-reading nav{align-items:stretch;flex-direction:column}.hero-copy nav a,.continue-reading a,.continue-reading button{text-align:center}.series-map{padding-inline:1rem}.series-map ol{grid-template-columns:repeat(3,1fr)}.series-map a{min-height:6rem}.episode-directory{padding-inline:1rem}.movement{margin-bottom:4rem}.movement>header{grid-template-columns:1fr auto}.movement>header p{grid-column:1/-1}.movement h2{font-size:2.1rem}.episode-row{grid-template-columns:3rem 6.5rem 1fr;gap:.7rem}.episode-row>i{display:none}.episode-row h3{font-size:1.1rem}.episode-row div>small{display:none}.system-note>div{grid-template-columns:1fr}}
</style>
<style is:global>.hero-visual img,.episode-row figure img{display:block;width:100%;height:100%;object-fit:cover}</style>
