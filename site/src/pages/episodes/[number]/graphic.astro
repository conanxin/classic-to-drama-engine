---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../../components/ResponsiveImage.astro';
import GraphicModeSwitch from '../../../components/GraphicModeSwitch.astro';
import GraphicIdentityStrip from '../../../components/GraphicIdentityStrip.astro';
import GraphicSceneBlock from '../../../components/GraphicSceneBlock.astro';
import StudySessionBridge from '../../../components/StudySessionBridge.astro';
import episodes from '../../../generated/episodes.json';
import graphicEpisodes from '../../../generated/graphic-episodes.json';
import panelManifest from '../../../generated/graphic-panels.json';
import characterSystem from '../../../generated/graphic-characters-p7b.json';
import { episodePath, formatRuntime, graphicEpisodePath, withBase } from '../../../lib/urls';

export function getStaticPaths() {
  return graphicEpisodes.map((graphicEpisode) => ({
    params: { number: String(graphicEpisode.number).padStart(2, '0') },
    props: { graphicEpisode, episode:episodes[graphicEpisode.number - 1] }
  }));
}
const { graphicEpisode, episode } = Astro.props;
const previousGraphic = graphicEpisode.previous_episode ? graphicEpisodes[graphicEpisode.previous_episode - 1] : null;
const nextGraphic = graphicEpisode.next_episode ? graphicEpisodes[graphicEpisode.next_episode - 1] : null;
const panelById = new Map(panelManifest.panels.map((panel) => [panel.panel_id, panel]));
const recapPanels:any[] = graphicEpisode.recap_panel_ids.map((id) => panelById.get(id)).filter(Boolean);
const characters = characterSystem.characters;
const relationName = (id:string) => id === 'household' ? '伊萨卡家宅' : characters.find((item) => item.id === id)?.name || id;
const pad = (number:number) => String(number).padStart(2, '0');
const isEp01Repair = graphicEpisode.repair_variant === 'ep01-r1' || graphicEpisode.repair_variant === 'ep01-r2';
const isEp01Final = graphicEpisode.repair_variant === 'ep01-r2';
const isSeriesPropagation = graphicEpisode.repair_variant === 'series-r3';
const isComicFinal = isEp01Final || isSeriesPropagation;
const essentialCast:any[] = graphicEpisode.cast.slice(0, 4).map((id) => characters.find((item) => item.id === id)).filter(Boolean);
const hookPanel = graphicEpisode.scenes.at(-1)?.panels.at(-1);
---
<BaseLayout title={`EP${pad(graphicEpisode.number)}《${graphicEpisode.title}》｜图像小说式剧本`} description={`${graphicEpisode.core_conflict}。《归途：奥德修斯》完整 Graphic Novel Script Edition。`} image={withBase(graphicEpisode.cover_visual.path)}>
  <article class:list={['graphic-reader', { 'ep01-r1-reader':isEp01Repair, 'ep01-r2-reader':isComicFinal, 'comic-final-reader':isComicFinal, 'long-title':graphicEpisode.title.length >= 7 }]} style={`--graphic-accent:${graphicEpisode.palette.accent};--graphic-accent-2:${graphicEpisode.palette.secondary};--graphic-cover:${graphicEpisode.palette.dominant}`} data-graphic-episode={graphicEpisode.episode} data-graphic-number={graphicEpisode.number} data-scene-count={graphicEpisode.scenes.length} data-pagefind-meta={`type:图文剧本, episode:${graphicEpisode.episode}`} data-comic-repair={isEp01Final ? 'P8R2' : isEp01Repair ? 'P8R1' : undefined} data-comic-grammar="P8R3">
    <header class="episode-cover">
      <div class="cover-copy">
        <p class="eyebrow">HIGH-FIDELITY GRAPHIC NOVEL · {graphicEpisode.episode}</p>
        <p class="story-stage">{graphicEpisode.story_stage}</p>
        <h1>{graphicEpisode.title}</h1>
        <p class="core-conflict">{graphicEpisode.core_conflict}</p>
        <GraphicModeSwitch number={graphicEpisode.number} active="graphic" />
        {isComicFinal ? <details class="cover-metadata"><summary>集数资料</summary><dl><div><dt>时长</dt><dd>{formatRuntime(graphicEpisode.runtime_seconds)}</dd></div><div><dt>场次</dt><dd>{graphicEpisode.scenes.length}</dd></div><div><dt>来源</dt><dd>Books {graphicEpisode.source_books.join(' / ')}</dd></div><div><dt>全剧进度</dt><dd>第 {graphicEpisode.number} / 30 集</dd></div></dl></details> : <dl><div><dt>时长</dt><dd>{formatRuntime(graphicEpisode.runtime_seconds)}</dd></div><div><dt>场次</dt><dd>{graphicEpisode.scenes.length}</dd></div><div><dt>来源</dt><dd>Books {graphicEpisode.source_books.join(' / ')}</dd></div><div><dt>全剧进度</dt><dd>第 {graphicEpisode.number} / 30 集</dd></div></dl>}
      </div>
      <figure class="cover-image"><ResponsiveImage src={graphicEpisode.cover_visual.path} alt={graphicEpisode.cover_visual.alt} loading="eager" fetchpriority="high" sizes="(max-width: 850px) 100vw, 60vw" /><figcaption>{graphicEpisode.cover_visual.authority}</figcaption></figure>
    </header>

    {(isEp01Repair || isSeriesPropagation) ? <section class="ep01-story-entry" aria-label={`${graphicEpisode.episode} 故事入口`}>
      <div class="entry-copy"><p class="eyebrow">{isEp01Repair ? '故事从一只被夺走的杯子开始' : '本集故事入口'}</p><p>{graphicEpisode.core_conflict}</p></div>
      <ul aria-label="先认这四个人">{essentialCast.map((character) => <li style={`--cast:${character.color}`}><b aria-hidden="true">{character.name.slice(0,1)}</b><span><strong>{character.name}</strong><small>{character.aliases[0]}</small></span></li>)}</ul>
      <details class="identity-deep"><summary>需要时查看全部人物与识别锚点</summary><GraphicIdentityStrip cast={graphicEpisode.cast} characters={characters} /></details>
    </section> : <>
      <section class="reader-orientation" aria-label="本集进入信息">
        <div><p class="eyebrow">PREVIOUSLY ON</p><p>{graphicEpisode.previously_on}</p></div>
        <div><p class="eyebrow">CORE CONFLICT</p><p>{graphicEpisode.core_conflict}</p></div>
        {recapPanels.length > 0 && <div class="recap-strip" aria-label="上一集视觉回顾">{recapPanels.map((panel) => <figure><ResponsiveImage src={panel.visual.public_path} alt={`上一集回顾：${panel.alt}`} sizes="(max-width: 850px) 50vw, 22vw" /></figure>)}</div>}
      </section>
      <GraphicIdentityStrip cast={graphicEpisode.cast} characters={characters} />
    </>}

    <details class="relation-map" data-study-event="relationship_assist_open">
      <summary><span><small>LEVEL 2 · CONTEXT</small><strong>本集关系速览</strong></span><i>需要时展开，不提前替人物完成判断</i></summary>
      <div>{graphicEpisode.relationships.map((relation) => <p><span>{relationName(relation.from)}</span><strong>{relation.label}</strong><span>{relationName(relation.to)}</span></p>)}</div>
    </details>

    <div class="graphic-body">
      <nav class="scene-progress" aria-label="本集场次进度" data-pagefind-ignore>
        <a class="back" href={withBase('graphic/')}>图文目录</a>
        <ol>{graphicEpisode.scenes.map((scene) => <li><a href={`#scene-${scene.number}`} data-scene-link={scene.number}><span>{pad(scene.number)}</span><small>{scene.location}</small></a></li>)}</ol>
        <div class="progress-readout"><p><span data-progress-current>01</span> / {pad(graphicEpisode.scenes.length)}</p><progress max="100" value="0" data-reading-progress aria-label="本集阅读进度"></progress><small data-progress-percent>0%</small><b>{graphicEpisode.number}/30</b></div>
      </nav>
      <div class="scene-stream">{graphicEpisode.scenes.map((scene) => <GraphicSceneBlock scene={scene} sourceScene={episode.scenes[scene.source_scene_index]} characters={characters} repairVariant={graphicEpisode.repair_variant} />)}</div>
    </div>

    {isComicFinal && hookPanel ? <footer class="graphic-hook comic-cliffhanger ep01-cliffhanger">
      <figure><ResponsiveImage src={hookPanel.visual.public_path} alt={hookPanel.alt} sizes="100vw" /><figcaption>
        <p class="eyebrow">{graphicEpisode.episode} · 最后一格</p><p class="hook-action">{hookPanel.visible_action}</p><h2>{isEp01Final ? '“门锁好。别替我告别。”' : graphicEpisode.end_hook}</h2>
        {nextGraphic ? <a class="hook-primary" href={graphicEpisodePath(nextGraphic.number)} data-study-next>进入 Graphic EP{pad(nextGraphic.number)} · {nextGraphic.title}</a> : <a class="hook-primary" href={withBase('graphic/')} data-study-next>回到 30 集图文目录</a>}
      </figcaption></figure>
      <nav class="hook-secondary" data-pagefind-ignore>
        {nextGraphic && <a href={episodePath(nextGraphic.number)}>改读 EP{pad(nextGraphic.number)} 完整剧本</a>}
        <a href={episodePath(graphicEpisode.number)}>回到本集完整剧本</a>
        {previousGraphic && <a href={graphicEpisodePath(previousGraphic.number)}>上一集 Graphic EP{pad(previousGraphic.number)}</a>}
      </nav>
    </footer> : <footer class="graphic-hook">
      <p class="eyebrow">END HOOK · {graphicEpisode.episode}</p><h2>{graphicEpisode.end_hook}</h2>
      <nav data-pagefind-ignore>
        {nextGraphic ? <a href={graphicEpisodePath(nextGraphic.number)} data-study-next>继续 Graphic EP{pad(nextGraphic.number)} · {nextGraphic.title}</a> : <a href={withBase('graphic/')} data-study-next>回到 30 集图文目录</a>}
        {nextGraphic && <a href={episodePath(nextGraphic.number)}>改读 EP{pad(nextGraphic.number)} 完整剧本</a>}
        <a href={episodePath(graphicEpisode.number)}>回到本集完整剧本</a>
        {previousGraphic && <a href={graphicEpisodePath(previousGraphic.number)}>上一集 Graphic EP{pad(previousGraphic.number)}</a>}
      </nav>
    </footer>}
  </article>
  <StudySessionBridge mode="graphic" episode={graphicEpisode.episode} />
</BaseLayout>
<script>
  const links = [...document.querySelectorAll<HTMLElement>('[data-scene-link]')];
  const current = document.querySelector<HTMLElement>('[data-progress-current]');
  const scenes = [...document.querySelectorAll<HTMLElement>('.graphic-scene')];
  const progress = document.querySelector<HTMLProgressElement>('[data-reading-progress]');
  const percent = document.querySelector<HTMLElement>('[data-progress-percent]');
  const article = document.querySelector<HTMLElement>('[data-graphic-episode]');
  const episodeNumber = Number(article?.dataset.graphicNumber || 0);
  const sceneCount = Number(article?.dataset.sceneCount || scenes.length || 1);
  const resumeKey = 'ctde-graphic-resume-v1';
  let activeScene = 1;
  let saveTimer = 0;
  const persist = () => localStorage.setItem(resumeKey, JSON.stringify({ version:2, episode:episodeNumber, mode:'graphic', scene:activeScene, scrollY:Math.round(window.scrollY), updatedAt:new Date().toISOString() }));
  const schedulePersist = () => { window.clearTimeout(saveTimer); saveTimer = window.setTimeout(persist, 180); };
  const setActive = (scene:number) => {
    activeScene = scene;
    links.forEach((link) => link.toggleAttribute('aria-current', Number(link.dataset.sceneLink) === scene));
    if (current) current.textContent = String(scene).padStart(2, '0');
    const value = Math.round((scene / sceneCount) * 100);
    if (progress) progress.value = value;
    if (percent) percent.textContent = `${value}%`;
    schedulePersist();
  };
  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter((entry) => entry.isIntersecting).sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (visible) setActive(Number((visible.target as HTMLElement).id.replace('scene-', '')));
  }, { rootMargin:'-20% 0px -55% 0px', threshold:[0,.2,.6] });
  scenes.forEach((scene) => observer.observe(scene));
  setActive(1);
  localStorage.setItem('ctde-last-reading-mode', 'graphic');
  window.addEventListener('scroll', schedulePersist, { passive:true });
  window.addEventListener('pagehide', persist);
  if (new URLSearchParams(location.search).get('resume') === '1') {
    try {
      const saved = JSON.parse(localStorage.getItem(resumeKey) || 'null');
      if (saved?.episode === episodeNumber) requestAnimationFrame(() => window.scrollTo({ top:Number(saved.scrollY || 0), behavior:'auto' }));
    } catch { /* local resume state is optional */ }
  }
</script>
