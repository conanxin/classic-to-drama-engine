---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import prototypes from '../../generated/graphic-prototypes.json';
import characters from '../../generated/graphic-characters.json';
import { episodePath, formatRuntime, graphicEpisodePath } from '../../lib/urls';
const characterMap = new Map(characters.characters.map((item) => [item.id, item]));
---
<BaseLayout title="Graphic Mode｜《归途：奥德修斯》图文剧本" description="EP01、EP19、EP27 图像小说式短剧剧本原型：先认人、再进场，在不替代完整 V2 剧本的前提下降低阅读负担。">
  <div class="graphic-index">
    <header class="graphic-hero">
      <div class="hero-copy">
        <p class="eyebrow">GRAPHIC SCRIPT · P7A PROTOTYPE</p>
        <h1>先认人，<br />再进场。</h1>
        <p>Graphic Mode 是《归途：奥德修斯》的第二种阅读层：用批准的视觉锚点、关系提示与精选原文对白，帮助普通读者进入空间、记住人物、跟上冲突。</p>
        <div class="dual-note"><span>Graphic Mode</span><b>降低理解门槛</b><i>＋</i><span>Script Mode</span><b>保留完整 V2 原文</b></div>
      </div>
      <figure class="hero-visual"><ResponsiveImage src={prototypes[1].cover_visual.path} responsive={prototypes[1].cover_visual.responsive} alt={prototypes[1].cover_visual.alt} loading="eager" fetchpriority="high" sizes="(max-width: 850px) 100vw, 60vw" /></figure>
    </header>

    <section class="prototype-list" aria-labelledby="prototype-title">
      <header><p class="eyebrow">THREE READING TESTS</p><h2 id="prototype-title">三种阅读难题，三集原型</h2></header>
      {prototypes.map((prototype, index) => (
        <article class="prototype-row">
          <div class="prototype-number"><span>EP</span><strong>{String(prototype.number).padStart(2, '0')}</strong></div>
          <div class="prototype-image"><ResponsiveImage src={prototype.cover_visual.path} responsive={prototype.cover_visual.responsive} alt={prototype.cover_visual.alt} loading={index === 0 ? 'eager' : 'lazy'} sizes="(max-width: 850px) calc(100vw - 2rem), 42vw" /></div>
          <div class="prototype-copy">
            <p class="story-stage">{prototype.story_stage}</p><h3>{prototype.title}</h3><p>{prototype.core_conflict}</p>
            <dl><div><dt>时长</dt><dd>{formatRuntime(prototype.runtime_seconds)}</dd></div><div><dt>场次</dt><dd>{prototype.scenes.length}</dd></div><div><dt>人物</dt><dd>{prototype.cast.slice(0, 5).map((id) => characterMap.get(id)?.name).filter(Boolean).join('、')}</dd></div></dl>
            <nav aria-label={`EP${String(prototype.number).padStart(2,'0')}阅读入口`}><a class="primary" href={graphicEpisodePath(prototype.number)}>进入图文模式</a><a href={episodePath(prototype.number)}>阅读完整剧本</a></nav>
          </div>
        </article>
      ))}
    </section>

    <section class="system-note">
      <p class="eyebrow">ONE STORY · TWO READING LAYERS</p><h2>图像不是替故事变简单，<br />而是让复杂信息有位置。</h2>
      <div><p><strong>人物识别</strong>稳定色彩、轮廓、道具与称谓，帮助读者在多人场面中复位。</p><p><strong>关系辅助</strong>只显示当前阅读层已知的信息，保留伪装、怀疑与识别的戏剧张力。</p><p><strong>空间锚点</strong>每场至少一个可见空间或物件，让冲突不漂浮在抽象说明里。</p><p><strong>原文回到手边</strong>每个场块都能展开对应完整 V2 剧本，Graphic Mode 不替换 Script Mode。</p></div>
    </section>
  </div>
</BaseLayout>
<style>
  .graphic-index{--g-paper:#d8cfbb;--g-paper-2:#c6bda9;--g-ink:#151513;--g-muted:#9e9687;--g-rule:rgba(216,207,187,.22);background:var(--g-ink);color:var(--g-paper)}.graphic-hero{display:grid;grid-template-columns:minmax(22rem,.8fr) minmax(0,1.2fr);min-height:calc(100vh - var(--header));border-bottom:1px solid var(--g-rule)}.hero-copy{padding:clamp(4rem,8vw,8rem) var(--pad);display:flex;flex-direction:column;justify-content:center}.hero-copy h1{font-size:clamp(4rem,9vw,8rem);margin:.6rem 0 1.6rem;line-height:.86}.hero-copy>p:not(.eyebrow){max-width:34rem;font-family:var(--serif);font-size:clamp(1.05rem,1.8vw,1.35rem);color:var(--g-paper-2)}.hero-visual{margin:0;min-width:0;min-height:100%;background:#0c0c0b;overflow:hidden}.dual-note{display:grid;grid-template-columns:auto 1fr;gap:.2rem 1rem;margin-top:2rem;border-left:2px solid var(--rust);padding-left:1rem;font-size:.65rem}.dual-note span{letter-spacing:.12em;color:var(--g-muted)}.dual-note b{font-weight:400}.dual-note i{display:none}
  .prototype-list{max-width:92rem;margin:auto;padding:clamp(5rem,9vw,9rem) var(--pad)}.prototype-list>header{display:grid;grid-template-columns:15rem 1fr;gap:2rem;align-items:end;margin-bottom:4rem}.prototype-list h2{margin:0}.prototype-row{display:grid;grid-template-columns:5rem minmax(20rem,1fr) minmax(20rem,1fr);gap:clamp(1rem,3vw,3rem);padding:2rem 0;border-top:1px solid var(--g-rule);align-items:center}.prototype-number{align-self:start;display:flex;flex-direction:column;color:var(--g-muted)}.prototype-number span{font-size:.55rem;letter-spacing:.15em}.prototype-number strong{font-family:var(--serif);font-size:2.6rem;font-weight:400}.prototype-image{aspect-ratio:16/10;overflow:hidden;background:#0c0c0b}.prototype-copy h3{font-size:clamp(2rem,4vw,3.6rem);margin:.2rem 0 1rem}.story-stage{color:var(--rust);font-size:.65rem;letter-spacing:.1em}.prototype-copy>p:not(.story-stage){font-family:var(--serif);color:var(--g-paper-2)}.prototype-copy dl{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin:1.5rem 0}.prototype-copy dl div{border-top:1px solid var(--g-rule);padding-top:.5rem}.prototype-copy dt{font-size:.55rem;color:var(--g-muted)}.prototype-copy dd{margin:.2rem 0 0;font-size:.68rem}.prototype-copy nav{display:flex;gap:1rem;align-items:center}.prototype-copy nav a{font-size:.72rem;padding:.65rem 0}.prototype-copy nav .primary{background:var(--g-paper);color:var(--g-ink);padding:.65rem 1rem;text-decoration:none}
  .system-note{max-width:92rem;margin:auto;padding:clamp(4rem,8vw,8rem) var(--pad);border-top:1px solid var(--g-rule)}.system-note h2{max-width:20ch}.system-note>div{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-top:4rem}.system-note>div p{border-top:2px solid var(--rust);padding-top:1rem;color:var(--g-muted);font-family:var(--serif)}.system-note strong{display:block;color:var(--g-paper);font-family:var(--sans);font-size:.75rem;margin-bottom:.5rem}
  @media(max-width:850px){.graphic-hero{grid-template-columns:1fr;min-height:0}.hero-copy{min-height:32rem}.hero-visual{height:min(70vh,38rem)}.prototype-list>header{display:block}.prototype-list h2{margin-top:.5rem}.prototype-row{grid-template-columns:3rem 1fr}.prototype-image{grid-column:2}.prototype-copy{grid-column:2}.system-note>div{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.hero-copy{min-height:29rem}.hero-copy h1{font-size:4.2rem}.prototype-list{padding-inline:1rem}.prototype-row{grid-template-columns:1fr;gap:1rem}.prototype-number{display:block}.prototype-number span{margin-right:.3rem}.prototype-number strong{font-size:1.8rem}.prototype-image,.prototype-copy{grid-column:1}.prototype-copy dl{grid-template-columns:1fr 1fr}.prototype-copy dl div:last-child{grid-column:1/-1}.prototype-copy nav{align-items:stretch;flex-direction:column}.prototype-copy nav a{text-align:center;border:1px solid var(--g-rule);padding:.7rem}.system-note>div{grid-template-columns:1fr}}
</style>
<style is:global>.hero-visual img,.prototype-image img{display:block;width:100%;height:100%;object-fit:cover}.hero-visual img{filter:saturate(.86) contrast(1.02)}</style>
