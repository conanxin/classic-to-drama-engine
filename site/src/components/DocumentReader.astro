---
import { marked } from 'marked';
import { withBase } from '../lib/urls';
interface Heading { depth:number; text:string; id:string; }
interface Document { slug:string; title:string; deck:string; raw:string; headings:Heading[]; source_url:string; source:string; }
interface Props { document: Document; previous?:Document; next?:Document; }
const { document, previous, next } = Astro.props;
let headingIndex = 0;
const rendered = (await marked.parse(document.raw, { gfm:true })).replace(/<h([23])>([\s\S]*?)<\/h\1>/g, (match, depth, text) => {
  const heading = document.headings[headingIndex++];
  return heading ? `<h${depth} id="${heading.id}">${text}<a class="heading-anchor" href="#${heading.id}" aria-label="链接到此标题">#</a></h${depth}>` : match;
}).replaceAll('<table>', '<div class="table-scroll" tabindex="0" role="region" aria-label="可横向滚动的表格"><table>').replaceAll('</table>', '</table></div>');
---
<div class="document-shell">
  <aside class="doc-toc" data-pagefind-ignore>
    <p class="eyebrow">目录</p>
    <nav>{document.headings.map((heading)=><a class:list={[`depth-${heading.depth}`]} href={`#${heading.id}`}>{heading.text}</a>)}</nav>
  </aside>
  <article class="document-reader">
    <header><p class="eyebrow">CURATED PROJECT DOCUMENT</p><h1>{document.title}</h1><p>{document.deck}</p><nav class="doc-actions" aria-label="文档操作" data-pagefind-ignore><a href={withBase('production/')}>← 返回制作档案</a><a href={document.source_url}>在 GitHub 查看冻结源文件 ↗</a></nav></header>
    <div class="markdown-body" set:html={rendered} />
    <nav class="document-pagination" aria-label="相邻公开文档" data-pagefind-ignore>{previous ? <a href={withBase(`documents/${previous.slug}/`)}><small>上一篇</small><strong>{previous.title}</strong></a> : <span />}{next ? <a class="next" href={withBase(`documents/${next.slug}/`)}><small>下一篇</small><strong>{next.title}</strong></a> : <a class="next" href={withBase('production/')}><small>返回</small><strong>制作档案</strong></a>}</nav>
  </article>
</div>
<style>.document-shell{display:grid;grid-template-columns:16rem minmax(0,1fr);max-width:90rem;margin:auto}.doc-toc{position:sticky;top:0;max-height:100vh;overflow:auto;padding:3rem 1.5rem;border-right:1px solid var(--rule)}.doc-toc nav{display:flex;flex-direction:column}.doc-toc a{padding:.3rem 0;text-decoration:none;font-size:.7rem;color:var(--muted);line-height:1.45}.doc-toc a:hover{color:var(--paper)}.doc-toc .depth-3{padding-left:1rem}.document-reader{max-width:52rem;padding:clamp(3rem,7vw,7rem) var(--pad)}.document-reader>header{padding-bottom:3rem;border-bottom:1px solid var(--rule)}.document-reader h1{font-size:clamp(2.6rem,6vw,5rem)}.document-reader>header>p:not(.eyebrow){font-family:var(--serif);font-size:1.2rem;color:var(--paper-2)}.doc-actions{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.72rem}.markdown-body{font-family:var(--serif);font-size:1.02rem;line-height:1.9}.markdown-body :global(h1){display:none}.markdown-body :global(h2){font-size:2.2rem;margin:5rem 0 1.2rem;padding-top:1rem;border-top:1px solid var(--rule);scroll-margin-top:2rem}.markdown-body :global(h3){font-size:1.35rem;margin:2.8rem 0 1rem;scroll-margin-top:2rem}.markdown-body :global(.heading-anchor){font-family:var(--sans);font-size:.7rem;margin-left:.6rem;color:var(--muted);opacity:0;text-decoration:none}.markdown-body :global(h2:hover .heading-anchor),.markdown-body :global(h3:hover .heading-anchor){opacity:1}.markdown-body :global(p),.markdown-body :global(li){color:var(--paper-2)}.markdown-body :global(blockquote){margin:2rem 0;padding:1rem 1.5rem;border-left:2px solid var(--rust);background:var(--ink-2)}.markdown-body :global(pre){overflow:auto;background:var(--black);padding:1.2rem;font-size:.78rem}.markdown-body :global(code){font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.82em}.markdown-body :global(table){display:block;width:100%;overflow:auto;border-collapse:collapse;font-family:var(--sans);font-size:.72rem}.markdown-body :global(th),.markdown-body :global(td){padding:.55rem .8rem;border:1px solid var(--rule);text-align:left;min-width:8rem}.markdown-body :global(img){display:block;margin:2rem 0}.document-pagination{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:5rem}.document-pagination a{text-decoration:none;border-top:1px solid var(--rule);padding-top:1rem;display:flex;flex-direction:column}.document-pagination .next{text-align:right}.document-pagination small{color:var(--muted)}@media(max-width:800px){.document-shell{display:block}.doc-toc{display:none}.document-reader{padding-top:4rem}.markdown-body :global(h2){font-size:1.7rem}.document-pagination strong{font-size:.82rem}}</style>
<style is:global>
  .document-shell,.document-reader,.markdown-body{min-width:0}
  .document-reader{width:100%;overflow:hidden}
  .markdown-body code{overflow-wrap:anywhere;word-break:break-all;white-space:normal}
  .markdown-body pre code{overflow-wrap:normal;word-break:normal;white-space:inherit}
  .markdown-body .table-scroll{display:block;width:100%;max-width:100%;overflow-x:auto;overscroll-behavior-inline:contain}
  .markdown-body .table-scroll table{display:table;width:max-content;min-width:100%;max-width:none;contain:none;overflow:visible}
</style>
