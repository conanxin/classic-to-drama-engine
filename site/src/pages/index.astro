---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeIndex from '../components/EpisodeIndex.astro';
import episodes from '../generated/episodes.json';
import release from '../generated/p10-release.json';
import { withBase } from '../lib/urls';
const hero = release.volumes[0].cover.public_files.social_og;
---
<BaseLayout>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">30 集 · 5 卷 · DIGITAL GRAPHIC NOVEL</p>
      <h1>归途：<br />奥德修斯</h1>
      <p class="hero-sub">关于归乡、身份与被重新认出的故事。</p>
      <div class="hero-actions">
        <a class="primary-action" href={withBase('read/')}>开始阅读</a>
        <a class="secondary-action" href={withBase('publication/')}>下载出版版</a>
      </div>
    </div>
    <figure class="hero-visual">
      <img src={withBase(hero)} alt="《归途：奥德修斯》第一卷出版封面的读者版视觉" loading="eager" fetchpriority="high" width="1200" height="630" />
      <figcaption>DIGITAL GRAPHIC NOVEL EDITION · 1.0.0</figcaption>
    </figure>
  </section>

  <section class="home-facts" aria-label="作品规模">
    <p><strong>30</strong><span>Episodes</span></p>
    <p><strong>150</strong><span>Scenes</span></p>
    <p><strong>≈211</strong><span>Minutes</span></p>
    <p><strong>24</strong><span>Source Books</span></p>
  </section>

  <section class="section">
    <div class="section-header">
      <div><p class="eyebrow">READING FIRST</p><h2>从故事开始</h2></div>
      <div><p>三十集 Graphic Mode 已完整上线：画面、旁白与对白可以连续阅读。专业 Script Mode 与制作档案仍完整保留。</p><a class="text-link" href={withBase('read/')}>选择一卷，开始阅读</a></div>
    </div>
    <EpisodeIndex episodes={episodes.slice(0,6)} compact />
  </section>

  <section class="home-band">
    <div>
      <p class="eyebrow">THE ARCHIVE</p>
      <h2>从荷马史诗，到可以排练的一场戏。</h2>
    </div>
    <nav aria-label="档案主要入口">
      <a href={withBase('read/')}><span>01</span>在线阅读</a>
      <a href={withBase('publication/')}><span>02</span>出版版下载</a>
      <a href={withBase('about/')}><span>03</span>关于作品</a>
      <a href={withBase('characters/')}><span>04</span>人物与辨认</a>
      <a href={withBase('visual/')}><span>05</span>视觉世界</a>
      <a href={withBase('project/')}><span>06</span>项目档案</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .home-hero{min-height:calc(100svh - var(--header));display:grid;grid-template-columns:minmax(22rem,.84fr) minmax(0,1.16fr);border-bottom:1px solid var(--rule)}
  .hero-copy{padding:clamp(3rem,8vw,8rem) var(--pad);display:flex;flex-direction:column;justify-content:center}.hero-copy h1{margin:.6rem 0 1.4rem;max-width:8ch}.hero-sub{font-family:var(--serif);font-size:clamp(1.1rem,2vw,1.45rem);color:var(--paper-2);max-width:22rem}.hero-actions{display:flex;gap:1.4rem;align-items:center;margin-top:2rem}.primary-action,.secondary-action{text-decoration:none;font-size:.82rem}.primary-action{background:var(--paper);color:var(--ink);padding:.85rem 1.2rem}.secondary-action{border-bottom:1px solid var(--rust);padding:.7rem 0}.hero-visual{margin:0;min-height:32rem;position:relative;background:#0b0b0a;overflow:hidden}.hero-visual img{width:100%;height:100%;position:absolute;object-fit:cover;object-position:50% 50%;filter:saturate(.83) contrast(1.04)}.hero-visual::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(21,21,19,.32),transparent 24%)}.hero-visual figcaption{position:absolute;z-index:2;bottom:1.2rem;right:1.2rem;color:rgba(255,255,255,.65);font-size:.58rem;letter-spacing:.13em}.home-facts{max-width:var(--content);margin:auto;padding:2rem var(--pad);display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--rule)}.home-facts p{margin:0;display:flex;align-items:baseline;gap:.7rem}.home-facts strong{font-family:var(--serif);font-size:1.9rem;font-weight:400}.home-facts span{font-size:.65rem;letter-spacing:.12em;color:var(--muted);text-transform:uppercase}.section .episode-index{margin-top:2rem}.home-band{max-width:var(--content);margin:0 auto;padding:clamp(5rem,10vw,10rem) var(--pad);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(20rem,.8fr);gap:clamp(3rem,10vw,10rem);background:var(--earth);color:#f0eadc}.home-band h2{max-width:11ch;font-size:clamp(2.7rem,5.5vw,5.2rem)}.home-band .eyebrow{color:#d5c7ad}.home-band nav{display:flex;flex-direction:column;border-top:1px solid rgba(255,255,255,.3)}.home-band nav a{padding:1.2rem 0;border-bottom:1px solid rgba(255,255,255,.3);text-decoration:none;display:flex;gap:1.5rem}.home-band nav span{font-size:.65rem;opacity:.6}
  @media(max-width:820px){.home-hero{grid-template-columns:1fr;min-height:auto}.hero-copy{min-height:29rem}.hero-visual{min-height:52vw}.home-facts{grid-template-columns:repeat(2,1fr);gap:1.4rem}.home-band{grid-template-columns:1fr}.hero-actions{align-items:flex-start;flex-direction:column}.hero-visual::after{display:none}}
</style>
