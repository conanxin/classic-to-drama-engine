---
import BaseLayout from '../../layouts/BaseLayout.astro';
import media from '../../generated/media.json';
import { withBase } from '../../lib/urls';
---
<BaseLayout title="观看 Pitch Teaser Previs｜《归途：奥德修斯》" description="观看《归途：奥德修斯》90 秒 P5 Pitch Teaser Previs。">
  <section class="watch-shell">
    <header><p class="eyebrow">P5 PITCH TEASER · PREVIS · 90 SECONDS</p><h1>先看见归途，<br />再听见名字。</h1><p>这是制作前的节奏与视觉证明，不是正式 Trailer。</p></header>
    <article class="video-feature">
      <div class="video-wrap"><video controls preload="metadata" playsinline poster={withBase('media/visual/hero/P4-HF-01-w1600.webp')} src={withBase(media.pitch_teaser)}>你的浏览器不支持 HTML5 视频。<a href={withBase(media.pitch_teaser)}>下载视频</a></video></div>
      <footer><span>P5 PITCH PREVIS — NOT FINAL TRAILER</span><a href={withBase(media.pitch_teaser)}>下载 90 秒 MP4</a></footer>
    </article>
    <article class="secondary-previs">
      <div><p class="eyebrow">P4 VISUAL PREVIS · EARLIER DEVELOPMENT PASS</p><h2>视觉系统的前一轮节奏证明</h2><p>P4 teaser 保留为可核对的视觉开发阶段记录。它同样是 PREVIS，不是正式 Trailer。</p></div>
      <div class="video-wrap"><video controls preload="none" playsinline poster={withBase('media/visual/hero/P4-HF-16-w1600.webp')} src={withBase(media.p4_teaser)}>你的浏览器不支持 HTML5 视频。<a href={withBase(media.p4_teaser)}>下载 P4 Previs</a></video></div>
      <footer><span>P4 PREVIS — 视觉开发档案</span><a href={withBase(media.p4_teaser)}>下载 P4 MP4</a></footer>
    </article>
    <nav class="watch-next" aria-label="继续观看"><a href={withBase('animatics/')}>浏览 30 集 Animatics</a></nav>
  </section>
</BaseLayout>
<style>.watch-shell{max-width:90rem;margin:auto;padding:clamp(4rem,8vw,8rem) var(--pad)}.watch-shell>header{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:end;margin-bottom:3rem}.watch-shell h1{font-size:clamp(3rem,7vw,6.4rem);margin:.5rem 0}.watch-shell>header>p:last-child{font-family:var(--serif);font-size:1.2rem;color:var(--muted);max-width:25rem}.video-wrap{background:#000}.video-wrap video{display:block;width:100%;aspect-ratio:16/9}.watch-shell footer{display:flex;justify-content:space-between;padding:.8rem 0;font-size:.68rem;letter-spacing:.1em;color:var(--muted)}.secondary-previs{display:grid;grid-template-columns:.68fr 1.32fr;gap:2.5rem;margin-top:clamp(5rem,10vw,10rem);padding-top:3rem;border-top:1px solid var(--rule)}.secondary-previs h2{font-size:clamp(1.8rem,3vw,3rem)}.secondary-previs>div:first-child>p:last-child{color:var(--muted);max-width:28rem}.secondary-previs footer{grid-column:2}.watch-next{display:flex;justify-content:flex-end;margin-top:4rem}.watch-next a{border-bottom:1px solid var(--rust);text-decoration:none;padding-bottom:.3rem}@media(max-width:700px){.watch-shell>header,.secondary-previs{grid-template-columns:1fr}.secondary-previs footer{grid-column:auto}.watch-shell footer{flex-direction:column;gap:.7rem}.watch-next{justify-content:flex-start}}</style>
