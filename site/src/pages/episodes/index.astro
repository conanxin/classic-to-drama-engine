---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EpisodeIndex from '../../components/EpisodeIndex.astro';
import episodes from '../../generated/episodes.json';
import { withBase } from '../../lib/urls';
---
<BaseLayout title="三十集剧本｜《归途：奥德修斯》" description="浏览《归途：奥德修斯》完整三十集 V2 制作剧本。">
  <PageIntro eyebrow="SCREENPLAY V2 · 30 EPISODES" title="三十次出发，一次归家。" deck="从忒勒马科斯无法拿回父亲的酒杯，到共同体看见武器被放下。完整 V2 正文按集呈现，来源覆盖《奥德赛》Books 1–24。" />
  <aside class="graphic-entry">
    <div><p class="eyebrow">DUAL READING MODE</p><h2>想先看见人物，再进入对白？</h2></div>
    <div><p>EP01、EP19、EP27 已开放图文模式原型。原剧本保持不变，新增人物、关系、空间和关键道具提示。</p><a class="text-link" href={withBase('graphic/')}>进入 Graphic Mode</a></div>
  </aside>
  <section class="section episode-catalog">
    <EpisodeIndex episodes={episodes} />
  </section>
</BaseLayout>
<style>.episode-catalog{padding-top:1rem}.graphic-entry{max-width:var(--content);margin:auto;padding:2.2rem var(--pad);display:grid;grid-template-columns:1fr 1.4fr;gap:2rem;border-bottom:1px solid var(--rule);background:var(--ink-2)}.graphic-entry h2{font-size:clamp(1.6rem,3vw,2.6rem)}.graphic-entry p{color:var(--muted);max-width:42rem}@media(max-width:760px){.graphic-entry{grid-template-columns:1fr}}</style>
