---
import GraphicPanelSequence from './GraphicPanelSequence.astro';

interface Character { id:string; name:string; color:string; aliases:string[]; faction:string; recognition_level:string; }
interface SourceBlock { type:string; text:string; }
interface Props { scene:any; sourceScene:{ blocks:SourceBlock[] }; characters:Character[]; repairVariant?:string; }
const { scene, sourceScene, characters, repairVariant = '' } = Astro.props;
const comicRepair = ['ep01-r1','ep01-r2','series-r3'].includes(repairVariant);
const comicFinal = ['ep01-r2','series-r3'].includes(repairVariant);
const ep01R1 = repairVariant === 'ep01-r1';
const ep01R2 = repairVariant === 'ep01-r2';
const cast = scene.cast.map((entry:any) => ({ ...entry, character:characters.find((item) => item.id === entry.character_id) })).filter((entry:any) => entry.character);
const glanceCast = comicFinal ? cast.slice(0, 4) : cast;
const factionLabels:Record<string,string> = { household:'家宅核心', 'loyal-household':'忠诚家宅', suitors:'求婚者阵营', gods:'神明层', 'sea-pressure':'海神压力', phaeacia:'菲埃克斯', otherworld:'异境', sailors:'船员', civic:'城邦／旅途' };
const compactCast = `${cast.slice(0, 3).map((entry:any) => entry.display_name).join('、')}${cast.length > 3 ? `等${cast.length}人/组` : ''}`;
---
<section class:list={['graphic-scene', { 'comic-repair':comicRepair, 'comic-final':comicFinal, 'ep01-r1':ep01R1, 'ep01-r2':ep01R2 }, scene.composition && `scene-${scene.composition}`]} id={`scene-${scene.number}`} data-scene-id={scene.scene_id} data-study-scene>
  <header class="scene-heading">
    <div><span>WHERE · {scene.scene_id}</span><h2>{scene.heading}</h2></div>
    <p class="scene-goal"><span>AT STAKE</span>{scene.conflict_goal}</p>
  </header>

  <div class="scene-tools">
    <div class="cast-chips" aria-label="本场人物快速识别">
      {glanceCast.map((entry:any) => (
        <details class="character-assist" style={`--chip:${entry.character.color}`} data-study-event="character_assist_open" data-character-id={entry.character_id}>
          <summary aria-label={`${entry.display_name}，${entry.character.aliases[0]}。展开当前关系`}>
            <b aria-hidden="true">{entry.display_name.slice(0,1)}</b>
            <span><strong>{entry.display_name}</strong><small>{entry.identity_state || entry.character.aliases[0]}</small></span>
          </summary>
          <span class="assist-preview" aria-hidden="true">{entry.character.aliases[0]} · {factionLabels[entry.character.faction] || entry.character.faction}</span>
          <div class="assist-context">
            <p><span>阵营</span>{factionLabels[entry.character.faction] || entry.character.faction}</p>
            <p><span>当前状态</span>{entry.identity_state || '公开身份'}</p>
            <p><span>当前关系</span>{scene.relation_tip}</p>
            <a href={`#character-${entry.character_id}`}>查看本集识别卡</a>
          </div>
        </details>
      ))}
    </div>
    <details class="reorient" data-study-event="relationship_assist_open">
      <summary><span>现在有哪些人？</span><small>{compactCast}</small></summary>
      <div class="reorient-panel">
        <p class="current-goal"><span>本场目标</span>{scene.conflict_goal}</p>
        <ul>{cast.map((entry:any) => <li><i style={`--who:${entry.character.color}`} aria-hidden="true"></i><strong>{entry.display_name}</strong><span>{entry.identity_state || entry.character.aliases[0]} · {factionLabels[entry.character.faction] || entry.character.faction}</span></li>)}</ul>
        <dl><div><dt>LEVEL 2 · CONTEXT</dt><dd>{scene.relation_tip}</dd></div><div><dt>空间</dt><dd>{scene.space_tip}</dd></div><div><dt>关键物</dt><dd>{scene.prop_tip}</dd></div></dl>
      </div>
    </details>
  </div>

  <div class="scene-story">
    {!comicRepair && <div class="scene-bridge">{scene.narrative.map((paragraph:string) => <p>{paragraph}</p>)}</div>}
    <GraphicPanelSequence panels={scene.panels} characters={characters} repairVariant={repairVariant} composition={scene.composition} />
    <p class="change"><span>本场变化</span>{scene.consequence}</p>
    <details class="source-layer" data-pagefind-ignore data-study-event="source_layer_open">
      <summary>展开原剧本 <small>Script Mode 原文 · 本场完整</small></summary>
      <div class="source-blocks">
        {sourceScene.blocks.map((block:SourceBlock) => block.type === 'character'
          ? <p class="source-character">{block.text}</p>
          : block.type === 'dialogue'
            ? <p class="source-dialogue">{block.text}</p>
            : block.type === 'transition'
              ? <p class="source-transition">{block.text}</p>
              : <p class="source-action">{block.text}</p>)}
      </div>
    </details>
  </div>
</section>
<style>
  .graphic-scene{scroll-margin-top:3.6rem;border-bottom:1px solid var(--graphic-rule);padding:clamp(3.5rem,7vw,7rem) var(--graphic-pad)}.scene-heading,.scene-tools,.scene-story{max-width:90rem;margin-inline:auto}.scene-heading{display:grid;grid-template-columns:minmax(13rem,1fr) minmax(18rem,1fr);gap:2rem;align-items:end;margin-bottom:1.2rem}.scene-heading p,.scene-heading h2{margin:0}.scene-heading>div>span,.scene-goal span{display:block;color:var(--graphic-accent);font-size:.54rem;letter-spacing:.12em}.scene-heading h2{font-family:var(--sans);font-size:clamp(1rem,1.7vw,1.25rem);letter-spacing:.08em;margin-top:.35rem}.scene-goal{font-family:var(--serif);font-size:clamp(.95rem,1.4vw,1.1rem);line-height:1.55}.scene-goal span{margin-bottom:.25rem}
  .scene-tools{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(18rem,.8fr);gap:.8rem;margin-bottom:1.3rem}.cast-chips{display:flex;flex-wrap:wrap;gap:.35rem;align-items:flex-start}.character-assist{position:relative}.character-assist>summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:1.7rem auto;gap:.45rem;align-items:center;padding:.4rem .55rem;border:1px solid var(--graphic-rule);background:var(--graphic-ink-2)}.character-assist>summary::-webkit-details-marker{display:none}.character-assist>summary b{width:1.7rem;height:1.7rem;display:grid;place-items:center;background:var(--chip);color:#111;font-family:var(--serif)}.character-assist>summary span{display:flex;flex-direction:column}.character-assist>summary strong{font-size:.61rem}.character-assist>summary small{font-size:.49rem;color:var(--graphic-muted)}.assist-preview{position:absolute;z-index:4;left:0;bottom:calc(100% + .35rem);width:max-content;max-width:15rem;padding:.45rem .55rem;background:var(--graphic-paper);color:var(--graphic-ink);font-size:.58rem;box-shadow:0 .5rem 2rem rgba(0,0,0,.35);opacity:0;pointer-events:none;transform:translateY(.2rem);transition:opacity .15s,transform .15s}.character-assist:not([open])>summary:hover+.assist-preview,.character-assist:not([open])>summary:focus-visible+.assist-preview{opacity:1;transform:none}.assist-context{position:absolute;z-index:5;left:0;top:calc(100% + .35rem);width:min(19rem,calc(100vw - 2rem));padding:.8rem;background:var(--graphic-paper);color:var(--graphic-ink);box-shadow:0 .75rem 2.5rem rgba(0,0,0,.45);font-size:.68rem}.assist-context p{margin:0 0 .55rem;line-height:1.55}.assist-context p span{display:block;font-size:.5rem;letter-spacing:.1em;color:#675f53}.assist-context a{color:inherit;font-size:.6rem}
  .reorient{border:1px solid var(--graphic-rule);background:var(--graphic-ink-2)}.reorient>summary{list-style:none;cursor:pointer;padding:.62rem .75rem;display:flex;justify-content:space-between;gap:1rem;align-items:center}.reorient>summary::-webkit-details-marker{display:none}.reorient>summary span{font-family:var(--serif);font-size:.84rem}.reorient>summary small{font-size:.56rem;color:var(--graphic-muted);text-align:right}.reorient[open]>summary{border-bottom:1px solid var(--graphic-rule)}.reorient-panel{padding:.85rem}.current-goal{margin:0 0 .8rem;font-family:var(--serif);font-size:.78rem}.current-goal span{display:block;font-family:var(--sans);font-size:.5rem;color:var(--graphic-accent);letter-spacing:.1em}.reorient ul{list-style:none;padding:0;margin:0 0 .8rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.35rem}.reorient li{display:grid;grid-template-columns:.45rem auto 1fr;gap:.4rem;align-items:baseline;font-size:.61rem}.reorient li i{width:.38rem;height:.38rem;background:var(--who)}.reorient li span{color:var(--graphic-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.reorient dl{margin:0}.reorient dl div{border-top:1px solid var(--graphic-rule);padding:.55rem 0}.reorient dt{font-size:.5rem;color:var(--graphic-muted);letter-spacing:.1em}.reorient dd{margin:.2rem 0 0;font-family:var(--serif);font-size:.72rem;line-height:1.55}
  .scene-bridge{max-width:48rem;margin:1.5rem 0 2rem;font-family:var(--serif);font-size:clamp(.95rem,1.5vw,1.12rem);line-height:1.85;color:var(--graphic-paper-2)}.scene-bridge p{margin:.6rem 0}.change{display:grid;grid-template-columns:7rem 1fr;gap:1rem;margin:2rem 0;padding:1rem 0;border-block:1px solid var(--graphic-rule);font-family:var(--serif)}.change span{font-family:var(--sans);font-size:.56rem;letter-spacing:.12em;color:var(--graphic-accent)}
  .source-layer{margin-top:1.6rem;border:1px solid var(--graphic-rule);background:rgba(0,0,0,.15)}.source-layer summary{cursor:pointer;padding:.9rem 1rem;font-size:.72rem;letter-spacing:.08em}.source-layer summary small{display:block;margin-top:.15rem;color:var(--graphic-muted);font-size:.58rem}.source-blocks{padding:clamp(1.1rem,4vw,2.5rem);border-top:1px solid var(--graphic-rule);font-size:.88rem}.source-action{font-family:var(--serif);line-height:1.9}.source-character{width:75%;margin:1.7rem auto .2rem;font-weight:600;letter-spacing:.1em}.source-dialogue{width:75%;margin:.2rem auto 1rem;line-height:1.8}.source-transition{text-align:right;font-size:.7rem;letter-spacing:.12em}
  .comic-repair{padding-top:clamp(2.8rem,5.5vw,5rem);background:linear-gradient(180deg,rgba(255,255,255,.012),transparent 18rem)}.comic-repair .scene-heading{grid-template-columns:minmax(16rem,1.2fr) minmax(18rem,.8fr);margin-bottom:.85rem}.comic-repair .scene-heading h2{font-size:clamp(1.05rem,1.9vw,1.35rem)}.comic-repair .scene-goal{padding-left:1rem;border-left:2px solid var(--graphic-accent);font-size:clamp(1rem,1.45vw,1.16rem)}.comic-repair .scene-tools{grid-template-columns:minmax(0,1fr) auto;align-items:start;margin-bottom:1rem}.comic-repair .cast-chips{gap:.28rem}.comic-repair .character-assist>summary{background:transparent;padding:.3rem .42rem}.comic-repair .reorient{min-width:15rem;background:transparent}.comic-repair .scene-story{padding-top:.25rem}.comic-repair .change{max-width:52rem;margin:1.5rem 0 1.2rem;padding:.8rem 0;font-size:.93rem}.comic-repair .source-layer{max-width:52rem;margin-top:1rem;background:transparent}.comic-repair .source-layer summary{padding:.72rem .85rem;color:var(--graphic-muted)}
  .comic-final .scene-heading{align-items:start}.comic-final .scene-goal{max-width:34rem}.comic-final .scene-tools{margin-bottom:.65rem}.comic-final .change{display:inline-grid;width:fit-content;max-width:min(52rem,100%);grid-template-columns:auto minmax(0,1fr);gap:.75rem;margin:1.15rem 0 .8rem;padding:.62rem .78rem;border:0;border-left:3px solid var(--graphic-accent);background:rgba(216,207,187,.055);font-size:.88rem;line-height:1.55}.comic-final .change span{white-space:nowrap}.comic-final .source-layer{width:fit-content;max-width:100%;margin-top:.35rem;border-color:color-mix(in srgb,var(--graphic-rule) 62%,transparent)}.comic-final .source-layer summary{width:max-content;max-width:100%;padding:.52rem .68rem;font-size:.62rem}.comic-final .source-layer summary small{display:inline;margin-left:.4rem}.comic-final .panel-provenance{height:auto}
  @media(max-width:850px){.scene-heading{grid-template-columns:1fr}.scene-tools{grid-template-columns:1fr}.source-character,.source-dialogue{width:88%}.comic-repair .scene-heading,.comic-repair .scene-tools{grid-template-columns:1fr}.comic-repair .reorient{min-width:0}}
  @media(max-width:560px){.graphic-scene{padding-top:2.6rem;padding-bottom:3.1rem}.scene-heading{gap:.75rem}.scene-tools{gap:.65rem}.character-assist>summary{padding:.3rem .42rem}.assist-preview{display:none}.assist-context{position:fixed;inset:auto .75rem 4.25rem .75rem;width:auto;max-height:45vh;overflow:auto}.reorient>summary{padding:.58rem .65rem}.reorient-panel{padding:.7rem}.reorient ul{grid-template-columns:1fr}.scene-bridge{margin-block:1rem 1.3rem}.change{grid-template-columns:1fr;gap:.25rem}.source-blocks{font-size:.82rem}.comic-final .change{display:block;width:auto;padding:.6rem .7rem}.comic-final .change span{display:block;margin-bottom:.2rem}.comic-final .source-layer summary small{display:block;margin:.12rem 0 0}}
  @media(prefers-reduced-motion:reduce){.assist-preview{transition:none}}
</style>
