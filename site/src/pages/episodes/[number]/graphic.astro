  .reader-orientation{display:grid;grid-template-columns:1fr 1fr;max-width:90rem;margin:auto;padding:clamp(3rem,6vw,5rem) var(--graphic-pad);gap:1px;background:var(--graphic-rule)}.reader-orientation>div{background:var(--graphic-ink);padding:clamp(1.2rem,3vw,2.5rem)}.reader-orientation>div>p:last-child{font-family:var(--serif);font-size:clamp(1rem,1.7vw,1.25rem);margin:1rem 0 0;color:var(--graphic-paper-2)}.recap-strip{grid-column:1/-1!important;display:grid!important;grid-template-columns:1fr 1fr;padding:0!important;gap:1px}.recap-strip figure{margin:0;aspect-ratio:16/6;overflow:hidden;background:#090908}
  .ep01-story-entry{max-width:90rem;margin:auto;padding:clamp(1.6rem,3.6vw,2.8rem) var(--graphic-pad);border-bottom:1px solid var(--graphic-rule);display:grid;grid-template-columns:minmax(17rem,1fr) minmax(22rem,1.25fr);gap:clamp(1rem,3vw,3rem);align-items:center}.entry-copy>p:last-child{max-width:34rem;margin:.45rem 0 0;font-family:var(--serif);font-size:clamp(1.05rem,1.65vw,1.28rem);line-height:1.65;color:var(--graphic-paper-2)}.ep01-story-entry ul{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.45rem;list-style:none;margin:0;padding:0}.ep01-story-entry li{min-width:0;display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.45rem;align-items:center;padding:.48rem;border-top:2px solid var(--cast);background:rgba(255,255,255,.025)}.ep01-story-entry li b{width:2rem;height:2rem;display:grid;place-items:center;background:var(--cast);color:#111;font-family:var(--serif)}.ep01-story-entry li span{min-width:0}.ep01-story-entry li strong,.ep01-story-entry li small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ep01-story-entry li strong{font-family:var(--serif);font-size:.72rem}.ep01-story-entry li small{font-size:.49rem;color:var(--graphic-muted);margin-top:.15rem}.identity-deep{grid-column:1/-1;border-top:1px solid var(--graphic-rule)}.identity-deep>summary{cursor:pointer;list-style:none;padding:.75rem 0;color:var(--graphic-muted);font-size:.62rem;letter-spacing:.06em}.identity-deep>summary::-webkit-details-marker{display:none}.identity-deep[open]>summary{color:var(--graphic-paper)}
  .cover-metadata{width:fit-content;max-width:100%;margin-top:1rem;border-top:1px solid var(--graphic-rule)}.cover-metadata>summary{cursor:pointer;list-style:none;width:max-content;max-width:100%;padding:.55rem 0;color:var(--graphic-paper-2);font-size:.62rem;letter-spacing:.08em}.cover-metadata>summary::-webkit-details-marker{display:none}.cover-metadata dl{margin-top:.5rem}.ep01-r2-reader .episode-cover{position:relative;display:grid;grid-template-columns:1fr;min-height:clamp(38rem,86svh,58rem);isolation:isolate}.ep01-r2-reader .cover-image,.ep01-r2-reader .cover-copy{grid-area:1/1}.ep01-r2-reader .cover-image{z-index:0;min-height:clamp(38rem,86svh,58rem);aspect-ratio:auto}.ep01-r2-reader .cover-image::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,10,9,.92) 0%,rgba(10,10,9,.66) 34%,rgba(10,10,9,.08) 72%),linear-gradient(0deg,rgba(10,10,9,.58),transparent 42%);pointer-events:none}.ep01-r2-reader .cover-copy{position:relative;z-index:1;width:min(48rem,64%);min-height:0;padding-block:clamp(2.5rem,6vw,5rem);justify-content:flex-end;background:transparent}.ep01-r2-reader .cover-copy h1{font-size:clamp(3.7rem,7vw,7rem);margin-bottom:.8rem}.long-title .cover-copy h1{font-size:clamp(3.2rem,6vw,6rem);text-wrap:balance}.ep01-r2-reader .core-conflict{margin-bottom:1.15rem}.ep01-r2-reader .ep01-story-entry{padding-block:1.25rem}.ep01-r2-reader .identity-deep>summary{padding-block:.55rem}
  .relation-map{max-width:90rem;margin:auto;padding:0 var(--graphic-pad);border-bottom:1px solid var(--graphic-rule)}.relation-map>summary{list-style:none;cursor:pointer;padding:1.2rem 0;display:flex;justify-content:space-between;align-items:center;gap:1.5rem}.relation-map>summary::-webkit-details-marker{display:none}.relation-map>summary span{display:flex;flex-direction:column}.relation-map>summary small{color:var(--graphic-accent);font-size:.54rem;letter-spacing:.12em}.relation-map>summary strong{font-family:var(--serif);font-size:1.15rem;font-weight:500}.relation-map>summary i{font-style:normal;font-size:.62rem;color:var(--graphic-muted)}.relation-map>div{border-top:2px solid var(--graphic-accent);padding-bottom:1.2rem}.relation-map>div p{display:grid;grid-template-columns:6rem 1fr 6rem;gap:1rem;align-items:center;margin:0;padding:.8rem 0;border-bottom:1px solid var(--graphic-rule)}.relation-map>div span{font-size:.6rem;color:var(--graphic-accent)}.relation-map>div span:last-child{text-align:right}.relation-map>div strong{font-family:var(--serif);font-weight:400;text-align:center}
  .graphic-body{display:grid;grid-template-columns:10rem minmax(0,1fr);max-width:105rem;margin:auto}.scene-progress{position:sticky;top:0;height:100vh;border-right:1px solid var(--graphic-rule);padding:2rem 1.2rem;align-self:start;display:flex;flex-direction:column;background:var(--graphic-ink);z-index:3}.scene-progress .back{font-size:.62rem;color:var(--graphic-muted)}.scene-progress ol{list-style:none;margin:auto 0;padding:0}.scene-progress li a{display:grid;grid-template-columns:1.5rem 1fr;gap:.5rem;align-items:center;text-decoration:none;padding:.65rem 0;color:var(--graphic-muted)}.scene-progress li a span{font-family:var(--serif);font-size:1rem}.scene-progress li a small{font-size:.57rem}.scene-progress li a[aria-current]{color:var(--graphic-paper)}.scene-progress li a[aria-current] span{color:var(--graphic-accent)}.progress-readout{display:grid;grid-template-columns:auto 1fr;gap:.3rem;align-items:center;font-size:.58rem;color:var(--graphic-muted)}.progress-readout p{grid-column:1/-1;margin:0}.progress-readout p span,.progress-readout small,.progress-readout b{color:var(--graphic-accent)}.progress-readout progress{width:100%;height:2px;border:0;background:var(--graphic-rule);accent-color:var(--graphic-accent)}.progress-readout small,.progress-readout b{font-size:.5rem;font-weight:400}.scene-stream{min-width:0}
  .graphic-hook{padding:clamp(4.5rem,9vw,9rem) var(--graphic-pad);max-width:90rem;margin:auto}.graphic-hook h2{max-width:23ch;font-size:clamp(2.5rem,5vw,5rem);margin:1rem 0 2.2rem}.graphic-hook nav{display:flex;gap:1rem;flex-wrap:wrap}.graphic-hook nav a{padding:.8rem 1rem;border:1px solid var(--graphic-rule);text-decoration:none;font-size:.72rem}.graphic-hook nav a:first-child{background:var(--graphic-paper);color:var(--graphic-ink)}
  .ep01-cliffhanger{max-width:none;padding:0;margin:0;border-top:1px solid var(--graphic-rule)}.ep01-cliffhanger figure{position:relative;margin:0;min-height:min(78vh,54rem);overflow:hidden;background:#080808}.ep01-cliffhanger figcaption{position:absolute;inset:auto auto clamp(1rem,4vw,3.5rem) var(--graphic-pad);width:min(40rem,calc(100% - 2 * var(--graphic-pad)));padding:clamp(1rem,2.4vw,2rem);background:linear-gradient(135deg,rgba(12,12,11,.94),rgba(12,12,11,.72));border-left:3px solid var(--graphic-accent)}.ep01-cliffhanger .hook-action{max-width:36rem;margin:.55rem 0 0;font-family:var(--serif);font-size:clamp(.9rem,1.45vw,1.12rem);line-height:1.6;color:var(--graphic-paper-2)}.ep01-cliffhanger h2{font-size:clamp(2rem,4.2vw,4.5rem);margin:.75rem 0 1.5rem}.ep01-cliffhanger nav a{background:rgba(12,12,11,.72)}
