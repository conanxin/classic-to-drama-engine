---
import BaseLayout from '../../layouts/BaseLayout.astro';
import release from '../../generated/p10-release.json';
import sums from '../../../../distribution/odyssey_m1_p10b/SHA256SUMS.json';
import { withBase } from '../../lib/urls';
const formatBytes = (bytes:number) => bytes >= 1024 ** 3 ? `${(bytes/1024**3).toFixed(2)} GB` : `${(bytes/1024**2).toFixed(1)} MB`;
---
<BaseLayout title="验证下载｜《归途：奥德修斯》1.0.0" description="核对《归途：奥德修斯》Digital Graphic Novel Edition 1.0.0 的 21 个正式发布文件。" image={withBase(release.volumes[4].cover.public_files.social_og)}>
  <article class="verify-page">
    <header><p class="eyebrow">EDITION 1.0.0 · SHA-256</p><h1>验证你下载的文件。</h1><p>这里列出 canonical GitHub Release 的 21 个文件名、字节数与 SHA-256。校验值相同，表示下载字节与冻结版本完全一致。</p><nav><a href={withBase('media/publication/p10/SHA256SUMS.txt')}>下载 SHA256SUMS.txt</a><a href={release.release_url}>查看 GitHub Release</a></nav></header>
    <section class="how"><h2>如何验证</h2><div><article><b>macOS / Linux</b><code>shasum -a 256 filename</code></article><article><b>Windows PowerShell</b><code>Get-FileHash filename -Algorithm SHA256</code></article><p>把输出与下表对应文件的 SHA-256 比较。不要用相近文件名或页面显示大小代替字节校验。</p></div></section>
    <section class="sum-list" aria-label="发布文件校验值">
      <header><h2>21 个冻结资产</h2><p>{formatBytes(sums.total_bytes)} · {sums.algorithm}</p></header>
      <ol>{sums.assets.map((asset)=><li><div><strong>{asset.filename}</strong><small>{asset.bytes.toLocaleString('en-US')} bytes</small></div><code>{asset.sha256}</code><a href={asset.url}>下载</a></li>)}</ol>
    </section>
    <footer><p>release tag: <code>{sums.release_tag}</code></p><p>ISBN: NOT_ASSIGNED · STORE_ACCEPTANCE: NOT_CLAIMED</p></footer>
  </article>
</BaseLayout>
<style>
  .verify-page{max-width:88rem;margin:auto;padding:0 var(--pad)}.verify-page>header{padding:clamp(5rem,10vw,10rem) 0;border-bottom:1px solid var(--rule)}.verify-page>header h1{max-width:13ch}.verify-page>header>p:not(.eyebrow){max-width:42rem;font:1.15rem/1.8 var(--serif);color:var(--paper-2)}.verify-page>header nav{display:flex;gap:1rem;margin-top:2rem}.verify-page>header a{font-size:.68rem;border-bottom:1px solid var(--rust);text-decoration:none}.how{padding:4rem 0;display:grid;grid-template-columns:1fr 2fr;gap:3rem;border-bottom:1px solid var(--rule)}.how>div{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.how article{border:1px solid var(--rule);padding:1rem}.how b{font-size:.62rem}.how code{display:block;margin-top:1rem;overflow-wrap:anywhere;color:var(--paper-2)}.how p{grid-column:1/-1;color:var(--muted)}.sum-list{padding:4rem 0}.sum-list>header{display:flex;justify-content:space-between;align-items:baseline}.sum-list ol{list-style:none;padding:0}.sum-list li{display:grid;grid-template-columns:minmax(18rem,.8fr) minmax(24rem,1.2fr) auto;gap:1.2rem;border-top:1px solid var(--rule);padding:1rem 0;align-items:center}.sum-list strong{display:block;font-size:.78rem}.sum-list small{color:var(--muted)}.sum-list code{font-size:.63rem;overflow-wrap:anywhere}.sum-list a{font-size:.65rem}.verify-page>footer{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--rule);padding:2rem 0;font-size:.68rem;color:var(--muted)}@media(max-width:760px){.verify-page{padding-inline:1rem}.how{grid-template-columns:1fr}.how>div{grid-template-columns:1fr}.sum-list li{grid-template-columns:1fr}.sum-list li a{justify-self:start}.verify-page>header nav,.verify-page>footer{flex-direction:column}.sum-list>header{display:block}}
</style>
