---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import world from '../../generated/world.json';
import visual from '../../generated/visual.json';
import { episodePath } from '../../lib/urls';
---
<BaseLayout title="世界与地点｜《归途：奥德修斯》" description="伊萨卡、海、菲埃克斯、独眼巨人洞穴、冥界与果园：归途的故事空间。">
  <PageIntro eyebrow="STORY WORLD · 24 LOCATION FAMILIES" title="海不断改变方向，家必须记得形状。" deck="这些地点不是 production unit ID 的目录。它们是人物做出选择的压力装置：门槛让身份变得可见，海让代价无法撤回，土地让一段故事成为证据。" />
  <section class="world-lead"><ResponsiveImage src={visual.sets[0]?.path} responsive={visual.sets[0]?.responsive} alt="伊萨卡厅堂批准视觉锚点" loading="eager" /><p>HOME / SEA / MEMORY</p></section>
  <section class="section world-list">
    {world.map((place,index)=><article><div><span>{String(index+1).padStart(2,'0')}</span><h2>{place.name}</h2></div><p>{place.thesis}</p><dl><dt>场次</dt><dd>{place.scene_count}</dd><dt>剧集</dt><dd>{place.episode_numbers.map((n)=><a href={episodePath(n)}>EP{String(n).padStart(2,'0')}</a>)}</dd></dl></article>)}
  </section>
</BaseLayout>
<style>.world-lead{margin:0;position:relative;height:min(65vw,48rem);background:var(--black)}.world-lead img{width:100%;height:100%;object-fit:cover}.world-lead p{position:absolute;bottom:1.5rem;left:var(--pad);font-size:.65rem;letter-spacing:.2em}.world-list article{display:grid;grid-template-columns:1fr 1fr 1fr;gap:2rem;padding:2.3rem 0;border-top:1px solid var(--rule)}.world-list article>div{display:grid;grid-template-columns:3rem 1fr}.world-list h2{font-size:2rem;margin:0}.world-list article>p{font-family:var(--serif);color:var(--paper-2)}.world-list dl{display:grid;grid-template-columns:3rem 1fr;font-size:.75rem;margin:0}.world-list dt{color:var(--muted)}.world-list dd{margin:0}.world-list dd a{margin-right:.7rem}@media(max-width:700px){.world-list article{grid-template-columns:1fr}.world-list article>div{grid-template-columns:2rem 1fr}}</style>
