---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import storyboards from '../../generated/storyboards.json';
import episodes from '../../generated/episodes.json';
import { episodePath, withBase } from '../../lib/urls';
export function getStaticPaths(){return storyboards.map((boards)=>({params:{episode:String(boards.number).padStart(2,'0')},props:{boards,episode:episodes[boards.number-1]}}));}
const { boards, episode } = Astro.props;
const previous = storyboards[boards.number - 2];
const next = storyboards[boards.number];
---
<BaseLayout title={`EP${String(boards.number).padStart(2,'0')} 技术分镜｜${episode.title}`} description={`EP${String(boards.number).padStart(2,'0')}《${episode.title}》技术分镜板与 shot/frame ID。`}>
  <header class="board-header"><div><p class="eyebrow">TECHNICAL STORYBOARD · EP{String(boards.number).padStart(2,'0')}</p><h1>{episode.title}</h1><p>{boards.pages.length} 页 · {episode.scene_count} 场 · P4 冻结技术板</p></div><ResponsiveImage src={boards.contact_sheet} responsive={boards.contact_sheet_responsive} alt={`EP${String(boards.number).padStart(2,'0')}技术分镜总联系表`} loading="eager" /></header>
  <section class="board-pages">
    {boards.pages.map((page,index)=><figure id={page.board_page_id}><button class="board-open" type="button" data-index={index} data-src={withBase(page.public_path)} data-label={`${page.board_page_id} · ${page.shot_ids.join(' · ')}`} aria-label={`放大 ${page.board_page_id}`}><ResponsiveImage src={page.public_path} responsive={page.public_responsive} alt={`${page.scene_id} ${page.shot_ids.join('、')} 技术分镜`} loading={index<2?'eager':'lazy'} /></button><figcaption><span>{page.board_page_id}</span><span>{page.scene_id}</span><span>{page.shot_ids.join(' · ')}</span><span>{page.frame_ids.length} frames</span></figcaption></figure>)}
  </section>
  <nav class="board-footer" aria-label="技术分镜导航">
    <div>{previous && <a href={withBase(`storyboards/${String(previous.number).padStart(2,'0')}/`)}>← EP{String(previous.number).padStart(2,'0')}</a>}<a href={withBase('storyboards/')}>分镜目录</a>{next && <a href={withBase(`storyboards/${String(next.number).padStart(2,'0')}/`)}>EP{String(next.number).padStart(2,'0')} →</a>}</div>
    <a href={episodePath(episode.number)}>阅读本集剧本</a>
  </nav>
  <dialog class="lightbox"><button class="lightbox-close" type="button" aria-label="关闭放大视图">关闭</button><img alt="放大的技术分镜" /><div class="lightbox-nav"><button type="button" data-lightbox-previous>← 上一页</button><p aria-live="polite"></p><button type="button" data-lightbox-next>下一页 →</button></div></dialog>
</BaseLayout>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const image = dialog?.querySelector('img');
  const label = dialog?.querySelector('.lightbox-nav p');
  const previous = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-previous]');
  const next = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const boards = [...document.querySelectorAll<HTMLButtonElement>('.board-open')];
  let active = 0;
  const show = (index:number) => { active=index;if(image)image.src=boards[index]?.dataset.src||'';if(label)label.textContent=boards[index]?.dataset.label||'';if(previous)previous.disabled=index===0;if(next)next.disabled=index===boards.length-1; };
  boards.forEach((button,index)=>button.addEventListener('click',()=>{show(index);dialog?.showModal()}));
  previous?.addEventListener('click',()=>show(Math.max(0,active-1)));
  next?.addEventListener('click',()=>show(Math.min(boards.length-1,active+1)));
  dialog?.querySelector('.lightbox-close')?.addEventListener('click',()=>dialog.close());
  dialog?.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close()});
  dialog?.addEventListener('keydown',(event)=>{if(event.key==='ArrowLeft')show(Math.max(0,active-1));if(event.key==='ArrowRight')show(Math.min(boards.length-1,active+1));if(event.key==='Escape'){event.preventDefault();dialog.close()}});
</script>
<style>.board-header{display:grid;grid-template-columns:.85fr 1.15fr;border-bottom:1px solid var(--rule)}.board-header>div{padding:clamp(3rem,7vw,7rem) var(--pad);display:flex;flex-direction:column;justify-content:center}.board-header h1{font-size:clamp(3rem,7vw,6rem)}.board-header>img{width:100%;height:100%;object-fit:cover;background:#eee}.board-pages{max-width:88rem;margin:auto;padding:var(--pad)}.board-pages figure{margin:0 0 4rem}.board-open{display:block;border:0;padding:0;background:#eee;width:100%;cursor:zoom-in}.board-open img{display:block;width:100%}.board-pages figcaption{display:grid;grid-template-columns:1fr 1fr 2fr 1fr;gap:1rem;padding:.65rem 0;border-bottom:1px solid var(--rule);font-size:.65rem;color:var(--muted)}.board-footer{max-width:88rem;margin:auto;padding:2rem var(--pad);display:flex;justify-content:space-between;gap:2rem}.board-footer div{display:flex;gap:1.5rem;flex-wrap:wrap}.lightbox{width:min(96vw,100rem);height:min(94vh,70rem);background:#111;border:1px solid #555;padding:3rem;color:#fff}.lightbox::backdrop{background:rgba(0,0,0,.88)}.lightbox img{width:100%;height:calc(100% - 2.5rem);object-fit:contain}.lightbox button{background:none;color:#fff;border:1px solid #777;padding:.4rem .7rem}.lightbox-close{position:absolute;right:1rem;top:1rem}.lightbox-nav{height:2.5rem;display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:end}.lightbox-nav p{margin:0;text-align:center;font-size:.68rem;color:#aaa}.lightbox-nav button:disabled{opacity:.35}.lightbox-nav button:not(:disabled){cursor:pointer}@media(max-width:720px){.board-header{grid-template-columns:1fr}.board-pages figcaption{grid-template-columns:1fr 1fr}.board-pages figcaption span:nth-child(3){grid-column:1/-1}.board-footer{align-items:flex-start;flex-direction:column}.lightbox{padding:3rem 1rem 1rem}.lightbox-nav p{display:none}}</style>
<style is:global>.board-header img{width:100%;height:100%;object-fit:cover;background:#eee}</style>
